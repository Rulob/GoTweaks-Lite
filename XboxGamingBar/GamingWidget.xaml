<Page
    x:Class="XboxGamingBar.GamingWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:XboxGamingBar"
    xmlns:converter="using:XboxGamingBar.Converter"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="670" d:DesignWidth="600">

    <Page.Resources>
        <!-- Existing Converters -->
        <converter:WattStringConverter x:Key="WattStringConverter"/>
        <converter:MegahertzStringConverter x:Key="MegahertzStringConverter"/>
        <converter:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converter:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converter:SharpnessPercentStringConverter x:Key="SharpnessPercentStringConverter"/>
        <converter:RadeonBoostResolutionStringConverter x:Key="RadeonBoostResolutionStringConverter"/>

        <!-- System Accent Color Brush (Light2 variant for dark theme text) -->
        <SolidColorBrush x:Key="SystemAccentBrush" Color="{ThemeResource SystemAccentColorLight2}"/>
        <!-- 1.9.9c: inside Game Bar the ThemeResource above can resolve to the default blue, so
             ApplyLiveAccentColor (code) sets this brush's colour from the app's live accent. Sliders
             and switches point at the same brush, so they all follow the Windows accent colour. -->
        <StaticResource x:Key="SliderTrackValueFill" ResourceKey="SystemAccentBrush"/>
        <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="SystemAccentBrush"/>
        <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="SystemAccentBrush"/>
        <StaticResource x:Key="SliderThumbBackground" ResourceKey="SystemAccentBrush"/>
        <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="SystemAccentBrush"/>
        <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="SystemAccentBrush"/>
        <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="SystemAccentBrush"/>
        <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="SystemAccentBrush"/>
        <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="SystemAccentBrush"/>
        <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="SystemAccentBrush"/>
        <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="SystemAccentBrush"/>
        <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="SystemAccentBrush"/>

        <!-- Win11 Theme Colors (promoted app-wide 2026-07-11 from the Performance-tab
             pilot checkpoint; matches the already-shipped Quick Settings tile palette) -->
        <!-- 1.9.9a "Handheld Console" palette: darker page, borderless cards, 16 px corners -->
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#121418"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1C1F25"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#00FFFFFF"/>
        <SolidColorBrush x:Key="CardInsetBrush" Color="#23272E"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA3AF"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#262A31"/>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2F343C"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#22262C"/>
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#1A1D22"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#00FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#00FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#00FFFFFF"/>
        <CornerRadius x:Key="ControlCornerRadius">10,10,10,10</CornerRadius>
        <Thickness x:Key="ButtonPadding">15,10,15,11</Thickness>

        <!-- Card Style - Win11 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        </Style>

        <!-- Card Focus Border Brush -->
        <SolidColorBrush x:Key="CardFocusBorderBrush" Color="White"/>

        <!-- Navigation RadioButton Style - Optimized for Handheld XY Navigation -->
        <!-- Uses RadioButtons group which treats tabs as single navigable unit -->
        <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9AA3AF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#888888"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#555555"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SystemAccentBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked"/>
                                    <VisualState x:Name="Indeterminate"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusBorder" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <!-- 1.9.9a: the selected tab gets a rounded raised background -->
                            <Border x:Name="SelectionIndicator"
                                    Background="#22262D"
                                    CornerRadius="10"
                                    Visibility="Collapsed"/>
                            <!-- Focus border with rounded corners -->
                            <Border x:Name="FocusBorder"
                                    BorderBrush="White"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    Visibility="Collapsed"/>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              AutomationProperties.AccessibilityView="Raw"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Title Style - Win11 -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- Card Title Style - Compact Mode -->
        <Style x:Key="CardTitleStyleCompact" TargetType="TextBlock" BasedOn="{StaticResource CardTitleStyle}">
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <!-- Card Caption Style - Win11 -->
        <Style x:Key="CardCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9AA3AF"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Section label (1.9.9a): small spaced capitals above a group of cards -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CharacterSpacing" Value="80"/>
            <Setter Property="Foreground" Value="#9AA3AF"/>
            <Setter Property="Margin" Value="4,18,0,0"/>
        </Style>

        <!-- Icon chip (1.9.9a): the rounded square that holds a card's icon -->
        <Style x:Key="IconChipStyle" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="#2C313A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Card Caption Style - Compact Mode -->
        <Style x:Key="CardCaptionStyleCompact" TargetType="TextBlock" BasedOn="{StaticResource CardCaptionStyle}">
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Card Value Style -->
        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SystemAccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Card Value Style - Compact Mode -->
        <Style x:Key="CardValueStyleCompact" TargetType="TextBlock" BasedOn="{StaticResource CardValueStyle}">
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <!-- Modern Toggle Style - Uses system style, focus highlight on parent card -->
        <Style x:Key="ModernToggleStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="MaxWidth" Value="40"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="OnContent" Value=""/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Modern Slider Style - Fluent with System Accent Color, focus on parent card -->
        <Style x:Key="ModernSliderStyle" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ManipulationMode" Value="None"/>
            <Setter Property="IsFocusEngagementEnabled" Value="True"/>
            <!-- High-visibility white focus ring for gamepad navigation (matches ModernToggleStyle) -->
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Modern ComboBox Style - System style with minor customizations -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <!-- High-visibility white focus ring for gamepad navigation -->
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Override ComboBox border colors to prevent highlight on focus/hover -->
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxBackground" Color="#262A31"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#2F343C"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#22262C"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#262A31"/>


        <!-- Reusable high-visibility white focus-ring setters for gamepad navigation.
             Merged into the interactive-control styles below so every button/toggle/checkbox
             shows the same clear white ring when focused with the pad. -->

        <!-- Modern Button Style - System style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Standalone Button Style - System style -->
        <Style x:Key="StandaloneButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Segment button (1.9.9a): one option of a row of choices, 44 px tall. The selected one
             gets the accent background and dark text in code. -->
        <Style x:Key="QuickSegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource StandaloneButtonStyle}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Profiles tab quick buttons (1.9.9a): a label over the current value -->
        <Style x:Key="ProfileQuickButtonStyle" TargetType="Button" BasedOn="{StaticResource StandaloneButtonStyle}">
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#23272E"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ProfileQuickLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9AA3AF"/>
        </Style>
        <Style x:Key="ProfileQuickValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Standalone ToggleButton Style - System style -->
        <Style x:Key="StandaloneToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Scale button (Scaling tab): accent-colored fill with dark text for contrast, in
             every state (idle and checked alike - no more accent-vs-gray distinction between
             them). Full custom template (not just resource overrides) so this stays scoped to
             this one control instead of affecting every other ToggleButton in the app (the
             many small expand/collapse chevron toggles). Disabled while there are unsaved
             Scale-tab setting changes pending Apply-and-Restart - see
             GamingWidget.LosslessScaling.cs's dirty-tracking. -->
        <Style x:Key="ScaleToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="{StaticResource ButtonPadding}"/>
            <Setter Property="Background" Value="{StaticResource SystemAccentBrush}"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonBackgroundDisabled}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked"/>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonBackgroundDisabled}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apply and Restart button (Scaling tab): default StandaloneButtonStyle look while
             disabled (no pending changes), but a custom template so that while it's enabled
             (green - see GamingWidget.LosslessScaling.cs's dirty-tracking) hovering/pressing
             darkens via opacity like the Scale button, instead of the system default template's
             PointerOver/Pressed VisualStates swapping to their own gray ButtonBackgroundPointerOver/
             Pressed resources (which would flash the green back to gray on hover, overriding
             whatever code-behind just set .Background to). Background/Foreground are driven
             entirely from code-behind (UpdateLosslessScalingDirtyState) - the Disabled VisualState
             here restores the normal disabled look regardless of what code-behind last set. -->
        <Style x:Key="LosslessScalingApplyButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonBackgroundDisabled}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonForegroundDisabled}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox with system style -->
        <Style x:Key="FocusableCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Default Button Style Override - uses system style -->
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Default ToggleButton Style Override - uses system style -->
        <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Default CheckBox Style Override - uses system style -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Section Header Style - Win11 -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CharacterSpacing" Value="80"/>
            <Setter Property="Foreground" Value="#9AA3AF"/>
            <Setter Property="Margin" Value="4,22,0,0"/>
        </Style>

        <!-- Quick Settings Tile Colors - Dark mode with sharp contrast -->
        <SolidColorBrush x:Key="TileOffBackground" Color="#1C1F25"/>
        <SolidColorBrush x:Key="TileOnBackground" Color="#1A2E1F"/>
        <SolidColorBrush x:Key="TileActiveBackground" Color="#1A2530"/>
        <SolidColorBrush x:Key="TileTriggerBackground" Color="#252030"/>
        <SolidColorBrush x:Key="TileBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="TileFocusBorderBrush" Color="White"/>
        <!-- Inactive state: even darker -->
        <SolidColorBrush x:Key="TileInactiveBackground" Color="#0D0E0F"/>
        <SolidColorBrush x:Key="TileInactiveForeground" Color="#606060"/>

        <!-- Quick Settings Tile Style - Xbox Game Bar Widget UI Guidelines -->
        <!-- Rest: normal background, Focus: rest + white stroke, Press: 10% darker, Focus+Press: press + stroke, Inactive: 50% darker -->
        <Style x:Key="QuickSettingsTileStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource TileOffBackground}"/>
            <Setter Property="BorderBrush" Value="#00FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"/>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="InactiveOverlay" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TileInactiveForeground}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusBorder" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- Background with a faint, constant Win11-style hairline
                                 border (same on every tile, doesn't change with state) -->
                            <Border x:Name="BackgroundBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"/>

                            <!-- Pressed overlay (10% darker) -->
                            <Border x:Name="PressedOverlay"
                                    Background="#1A000000"
                                    CornerRadius="12"
                                    Visibility="Collapsed"/>

                            <!-- Inactive overlay (50% darker) -->
                            <Border x:Name="InactiveOverlay"
                                    Background="#80000000"
                                    CornerRadius="12"
                                    Visibility="Collapsed"/>

                            <!-- Focus stroke border -->
                            <Border x:Name="FocusBorder"
                                    BorderBrush="White"
                                    BorderThickness="2"
                                    CornerRadius="12"
                                    Visibility="Collapsed"/>

                            <!-- Content -->
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Settings Edit Mode Checkbox Style -->
        <Style x:Key="TileVisibilityCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <ProgressRing x:Name="LoadingProgressRing"
                      IsActive="True"
                      Visibility="Collapsed"
                      Width="60"
                      Height="60"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

        <!-- Navigation Bar using RadioButtons for proper XY focus navigation -->
        <Grid x:Name="MainNavContainer">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Nav Bar Row -->
            <Grid Grid.Row="0" Background="Transparent" Margin="12,6,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LT indicator (1.9.9a: shoulder-shaped chip) -->
                <Border Grid.Column="0" Background="#C5CBD3" CornerRadius="10,4,4,10" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="LT" Foreground="#121418" FontSize="11" FontWeight="Bold"/>
                </Border>

                <!-- Navigation Tabs - StackPanel for proper horizontal XY navigation -->
                <!-- XYFocusKeyboardNavigation="Disabled" prevents vertical nav within, allows left/right -->
                <StackPanel x:Name="MainNavPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="2"
                            XYFocusKeyboardNavigation="Disabled">
                    <RadioButton x:Name="QuickNavItem" Tag="Quick" Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNav" Checked="NavRadioButton_Checked" AutomationProperties.Name="Quick">
                        <StackPanel Spacing="3">
                            <FontIcon Glyph="&#xECA5;" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Quick" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="PerformanceNavItem" Tag="Performance" Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNav" Checked="NavRadioButton_Checked" AutomationProperties.Name="Power">
                        <StackPanel Spacing="3">
                            <FontIcon Glyph="&#xE945;" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Power" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ProfilesNavItem" Tag="Game" Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNav" Checked="NavRadioButton_Checked" AutomationProperties.Name="Profiles">
                        <StackPanel Spacing="3">
                            <FontIcon Glyph="&#xE77B;" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Profiles" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LegionNavItem" Tag="Legion" Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNav" Visibility="Collapsed" Checked="NavRadioButton_Checked" AutomationProperties.Name="Legion">
                        <StackPanel Spacing="3">
                            <FontIcon Glyph="&#xE7FC;" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Legion" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SystemNavItem" Tag="System" Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNav" Checked="NavRadioButton_Checked" AutomationProperties.Name="System">
                        <StackPanel Spacing="3">
                            <FontIcon Glyph="&#xE713;" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="System" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- RT indicator and status dot -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                    <Border Background="#C5CBD3" CornerRadius="4,10,10,4" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="RT" Foreground="#121418" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <!-- Helper Connection Status Indicator -->
                    <Border x:Name="HelperStatusIndicator"
                            Background="#30000000"
                            CornerRadius="6"
                            Padding="4,2"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Helper Status"
                            Tapped="HelperStatusIndicator_Tapped">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse x:Name="HelperStatusDot"
                                     Width="8" Height="8"
                                     Fill="#FF5555"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="HelperStatusText"
                                       Text="Disconnected"
                                       Foreground="#B9C0CC"
                                       FontSize="9"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1">
            <!-- QUICK SETTINGS TAB -->
            <Grid>
                <ScrollViewer x:Name="QuickSettingsScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Visible"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="12,2,12,6">

                        <!-- Driver updates tile (Legion devices only, visible only when count > 0).
                             Helper pushes DriverUpdatesAvailable after its startup probe; the
                             click handler jumps to the Legion tab's Driver Updates section. -->
                        <Button x:Name="QuickDriverUpdatesTile"
                                Visibility="Collapsed"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="14,10"
                                Margin="0,0,0,8"
                                Background="#2A2032"
                                BorderBrush="#FFB060"
                                BorderThickness="1"
                                CornerRadius="12"
                                Click="QuickDriverUpdatesTile_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FFB060" CornerRadius="14" Width="28" Height="28" VerticalAlignment="Center">
                                    <TextBlock x:Name="QuickDriverUpdatesCountText"
                                               Text="0"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#1A1A1A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="QuickDriverUpdatesTitleText"
                                               Text="Driver updates available"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"/>
                                    <TextBlock Text="Tap to view on the Legion tab"
                                               FontSize="11"
                                               Foreground="#B9C0CC"/>
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="#B9C0CC" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- GoTweaks self-update banner: helper pushes GoTweaksUpdate
                             after its startup probe. Tap to trigger the install (the
                             helper downloads the signed .msixbundle and runs
                             Add-AppxPackage). Hidden when no update or when the user
                             opted into "Hide update banner". -->
                        <Button x:Name="QuickGoTweaksUpdateTile"
                                Visibility="Collapsed"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="14,10"
                                Margin="0,0,0,8"
                                Background="#202A38"
                                BorderBrush="#7EB6FF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Click="QuickGoTweaksUpdateTile_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE896;" FontSize="20" Foreground="#7EB6FF" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="QuickGoTweaksTitleText"
                                               Text="GoTweaks Lite update available"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="QuickGoTweaksSubtitleText"
                                               Text="Tap to install"
                                               FontSize="11"
                                               Foreground="#B9C0CC"/>
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE896;" FontSize="12" Foreground="#B9C0CC" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Power card (1.9.9b compact layout): TDP mode buttons 2 x 2 on the left, the dial
                             on the right (smaller, with a mini Custom slider under it in Custom), and one
                             AutoTDP row: switch on the left, target FPS stepper on the right. It drives the
                             Power tab's own controls (TDPModeComboBox, CustomTDPSlowSlider, AutoTDPToggle,
                             AutoTDPTargetFPSSlider), see GamingWidget.QuickPowerBoxes.cs. -->
                        <Border x:Name="QuickPowerCard"
                                Background="{StaticResource CardBackgroundBrush}"
                                CornerRadius="16"
                                Padding="10"
                                Margin="0,0,0,8">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid ColumnSpacing="6" RowSpacing="6" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button x:Name="QuickTdpModeQuiet" Grid.Row="0" Grid.Column="0" Tag="0" Content="Quiet" XYFocusUp="{x:Bind QuickNavItem}"
                                                Style="{StaticResource QuickSegmentButtonStyle}" Click="QuickTdpModeOption_Click"/>
                                        <Button x:Name="QuickTdpModeBalanced" Grid.Row="0" Grid.Column="1" Tag="1" Content="Balanced" XYFocusUp="{x:Bind QuickNavItem}"
                                                Style="{StaticResource QuickSegmentButtonStyle}" Click="QuickTdpModeOption_Click"/>
                                        <Button x:Name="QuickTdpModePerformance" Grid.Row="1" Grid.Column="0" Tag="2" Content="Performance" XYFocusDown="{x:Bind QuickAutoTdpToggle}"
                                                Style="{StaticResource QuickSegmentButtonStyle}" Click="QuickTdpModeOption_Click"/>
                                        <Button x:Name="QuickTdpModeCustom" Grid.Row="1" Grid.Column="1" Tag="3" Content="Custom"
                                                Style="{StaticResource QuickSegmentButtonStyle}" Click="QuickTdpModeOption_Click"/>
                                    </Grid>
                                    <!-- Dial: a 270 degree track drawn at 104 px and scaled by the Viewbox;
                                         the value arc is drawn in code. -->
                                    <StackPanel Grid.Column="1" Width="96" VerticalAlignment="Center">
                                        <Viewbox x:Name="QuickTdpDialBox" Width="94" Height="94" HorizontalAlignment="Center">
                                            <Grid Width="104" Height="104">
                                                <Path Data="M 19.47,84.53 A 46,46 0 1 1 84.53,84.53"
                                                      Stroke="#2C313A" StrokeThickness="10"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Path x:Name="QuickTdpDialArc"
                                                      Stroke="{StaticResource SystemAccentBrush}" StrokeThickness="10"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0">
                                                    <TextBlock x:Name="QuickTdpDialText" Text="--" FontSize="30" FontWeight="Bold"
                                                               HorizontalAlignment="Center"/>
                                                    <FontIcon x:Name="QuickTdpDialIcon" Glyph="&#xEC49;" FontSize="30"
                                                              HorizontalAlignment="Center" Margin="0,2,0,4" Visibility="Collapsed"/>
                                                    <TextBlock x:Name="QuickTdpDialUnit" Text="WATTS" FontSize="12" FontWeight="Bold"
                                                               CharacterSpacing="60" Foreground="{StaticResource MutedTextBrush}"
                                                               HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Viewbox>
                                        <!-- Custom wattage: mini slider, shown in Custom while AutoTDP is off -->
                                        <Slider x:Name="QuickTdpSlider" XYFocusUp="{x:Bind QuickNavItem}"
                                                Style="{StaticResource ModernSliderStyle}"
                                                Margin="0,-6,0,-8"
                                                Visibility="Collapsed"
                                                Minimum="5" Maximum="35" StepFrequency="1" SmallChange="1" Value="15"
                                                AutomationProperties.Name="Custom TDP"
                                                ValueChanged="QuickTdpSlider_ValueChanged"/>
                                    </StackPanel>
                                </Grid>
                                <!-- AutoTDP: switch on the left, target FPS on the right -->
                                <Border Background="{StaticResource CardInsetBrush}" CornerRadius="12" Padding="12,4,6,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid ColumnSpacing="10" Margin="0,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE9F5;" FontSize="18" Foreground="#C5CBD3" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="AutoTDP" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <ToggleSwitch x:Name="QuickAutoTdpToggle" Grid.Column="2"
                                                          Style="{StaticResource ModernToggleStyle}" Width="47"
                                                          AutomationProperties.Name="AutoTDP"
                                                          Toggled="QuickAutoTdpToggle_Toggled"/>
                                        </Grid>
                                        <Border Grid.Column="1" Width="1" Background="#2F343C" Margin="0,6"/>
                                        <Grid x:Name="QuickAutoTdpTargetPanel" Grid.Column="2" Margin="8,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="QuickAutoTdpMinusButton" Content="&#xE738;" FontFamily="Segoe Fluent Icons"
                                                    Width="38" Height="38" Padding="0" CornerRadius="9" FontSize="14"
                                                    AutomationProperties.Name="Lower target FPS"
                                                    Style="{StaticResource StandaloneButtonStyle}" Click="QuickAutoTdpStep_Click" Tag="-5"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="QuickAutoTdpTargetText" Text="60" FontSize="16" FontWeight="Bold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="TARGET FPS" FontSize="10" FontWeight="Bold" CharacterSpacing="40"
                                                           Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <Button x:Name="QuickAutoTdpPlusButton" Grid.Column="2" Content="&#xE710;" FontFamily="Segoe Fluent Icons"
                                                    Width="38" Height="38" Padding="0" CornerRadius="9" FontSize="14"
                                                    AutomationProperties.Name="Raise target FPS"
                                                    Style="{StaticResource StandaloneButtonStyle}" Click="QuickAutoTdpStep_Click" Tag="5"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <!-- Live sensor bars (1.9.9a): one row per selected metric, built in code -->
                        <Border x:Name="QuickMetricsRow"
                                Background="{StaticResource CardBackgroundBrush}"
                                CornerRadius="16"
                                Padding="16,14"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <StackPanel x:Name="QuickMetricsGrid" Spacing="10"/>
                        </Border>
                        <!-- Optional built-in display brightness slider (hidden by default, revealed under Customize) -->
                        <Border x:Name="PanelBrightnessRow"
                                Background="{StaticResource CardBackgroundBrush}"
                                CornerRadius="16"
                                Padding="16,0"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE706;"
                                          FontSize="18"
                                          Foreground="#C5CBD3"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"/>
                                <Slider x:Name="PanelBrightnessSlider"
                                        Grid.Column="1"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Minimum="0"
                                        Maximum="100"
                                        StepFrequency="5"
                                        SmallChange="5"
                                        LargeChange="10"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!-- Toggles (1.9.9b: a fixed set, two per row) and actions (one row of four), built in code -->
                        <TextBlock Text="TOGGLES" Style="{StaticResource SectionLabelStyle}" FontSize="11" Margin="4,0,0,4"/>
                        <StackPanel x:Name="QuickSettingsTilesContainer"/>
                        <TextBlock Text="ACTIONS" Style="{StaticResource SectionLabelStyle}" FontSize="11" Margin="4,0,0,4"/>
                        <Grid x:Name="QuickActionsGrid" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>

                        <!-- Customize Button -->
                        <!-- 1.9.9b: the Quick tab layout is fixed; Customize is no longer shown -->
                        <Button x:Name="QuickSettingsCustomizeButton"
                                Visibility="Collapsed"
                                Content="Customize"
                                HorizontalAlignment="Stretch"
                                Margin="0,16,0,0"
                                Style="{StaticResource StandaloneButtonStyle}"
                                Click="QuickSettingsCustomize_Click"/>

                        <!-- Customization Panel (hidden by default) -->
                        <Border x:Name="QuickSettingsCustomizePanel"
                                Style="{StaticResource CardStyle}"
                                Visibility="Collapsed"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Customize Tiles" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="Tap tile to select, tap another to swap. Tap same tile to toggle visibility."
                                           Style="{StaticResource CardCaptionStyle}"
                                           Margin="0,0,0,8"
                                           TextWrapping="Wrap"/>

                                <!-- Column Count Toggle -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Columns:"
                                               VerticalAlignment="Center"
                                               Foreground="#B9C0CC"
                                               FontSize="13"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="Column2Button"
                                                Content="2"
                                                MinWidth="40"
                                                Margin="0,0,4,0"
                                                Click="ColumnCount2_Click"/>
                                        <Button x:Name="Column3Button"
                                                Content="3"
                                                MinWidth="40"
                                                Margin="0,0,4,0"
                                                Click="ColumnCount3_Click"/>
                                        <Button x:Name="Column4Button"
                                                Content="4"
                                                MinWidth="40"
                                                Click="ColumnCount4_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Show Metrics Row Toggle -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Show Metrics Row"
                                                   Foreground="#FFFFFF"
                                                   FontSize="13"/>
                                        <TextBlock Text="Select up to 6 metrics below"
                                                   Foreground="#888888"
                                                   FontSize="11"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="QuickMetricsToggle"
                                                  Grid.Column="1"
                                                  OffContent=""
                                                  OnContent=""
                                                  Toggled="QuickMetricsToggle_Toggled"/>
                                </Grid>

                                <!-- Show Brightness Slider Toggle -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Show Brightness Slider"
                                                   Foreground="#FFFFFF"
                                                   FontSize="13"/>
                                        <TextBlock Text="Built-in screen brightness"
                                                   Foreground="#888888"
                                                   FontSize="11"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="PanelBrightnessToggle"
                                                  Grid.Column="1"
                                                  OffContent=""
                                                  OnContent=""
                                                  Toggled="PanelBrightnessToggle_Toggled"/>
                                </Grid>

                                <!-- Metrics Selection (visible when toggle is on) -->
                                <Border x:Name="MetricsSelectionPanel"
                                        Background="#1A1A2E"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,0,0,12"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Select Metrics (max 6)"
                                                   Foreground="#B9C0CC"
                                                   FontSize="11"
                                                   Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- Row 0 -->
                                            <CheckBox x:Name="MetricCheck_BatteryDrain" Content="Battery Drain" Grid.Row="0" Grid.Column="0" Foreground="White" FontSize="12" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed"/>
                                            <CheckBox x:Name="MetricCheck_BatteryLevel" Content="Battery Level" Grid.Row="0" Grid.Column="1" Foreground="White" FontSize="12" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed"/>
                                            <!-- Row 1 -->
                                            <CheckBox x:Name="MetricCheck_CPUUsage" Content="CPU Usage" Grid.Row="1" Grid.Column="0" Foreground="White" FontSize="12" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed"/>
                                            <CheckBox x:Name="MetricCheck_GPUUsage" Content="GPU Usage" Grid.Row="1" Grid.Column="1" Foreground="White" FontSize="12" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed"/>
                                            <!-- Row 2: same values as the overlay's TEMP and TDP items -->
                                            <CheckBox x:Name="MetricCheck_SoCTemp" Content="SoC Temp" Grid.Row="2" Grid.Column="0" Foreground="White" FontSize="12" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed"/>
                                            <CheckBox x:Name="MetricCheck_TDP" Content="TDP" Grid.Row="2" Grid.Column="1" Foreground="White" FontSize="12" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed"/>
                                            <!-- Row 3 -->
                                            <CheckBox x:Name="MetricCheck_MemoryUsage" Content="Memory Usage" Grid.Row="3" Grid.Column="0" Foreground="White" FontSize="12" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed"/>
                                            <CheckBox x:Name="MetricCheck_TimeRemaining" Content="Time Remaining" Grid.Row="3" Grid.Column="1" Foreground="White" FontSize="12" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed"/>
                                        </Grid>
                                        <TextBlock x:Name="MetricsSelectionCount" Text="0/6 selected" Foreground="#888888" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Right"/>

                                        <!-- Reorder Section -->
                                        <Border x:Name="MetricsReorderSection"
                                                Background="#1A1A2E"
                                                CornerRadius="6"
                                                Padding="8"
                                                Margin="0,10,0,0"
                                                Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="Reorder (drag or use arrows)"
                                                           Foreground="#888888"
                                                           FontSize="10"
                                                           Margin="0,0,0,6"/>
                                                <StackPanel x:Name="MetricsReorderList" Spacing="4"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Sortable Tile Grid - generated in code-behind -->
                                <StackPanel x:Name="TileSortableGrid"/>

                                <!-- Selected tile indicator -->
                                <Border x:Name="SelectedTileIndicator"
                                        Visibility="Collapsed"
                                        Background="#1A2530"
                                        CornerRadius="4"
                                        Padding="8"
                                        Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SelectedTileText"
                                                   Foreground="#00C8FF"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="DeleteSelectedTileButton"
                                                Grid.Column="1"
                                                Visibility="Collapsed"
                                                Background="#662020"
                                                Foreground="White"
                                                Margin="8,0,0,0"
                                                Padding="12,6"
                                                Click="DeleteSelectedTile_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="Delete"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Add Custom Shortcut Section -->
                                <TextBlock Text="Add Custom Shortcut"
                                           Style="{StaticResource CardTitleStyle}"
                                           Margin="0,16,0,8"/>
                                <TextBox x:Name="CustomShortcutNameBox"
                                         PlaceholderText="Tile Name"
                                         Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl x:Name="CustomShortcutKeyTags">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <ComboBox x:Name="CustomShortcutKeyComboBox" Width="90" Style="{StaticResource ModernComboBoxStyle}"
                                              SelectedIndex="0" SelectionChanged="CustomShortcutKey_SelectionChanged">
                                        <x:String>+ Key</x:String><x:String>A</x:String><x:String>B</x:String><x:String>C</x:String><x:String>D</x:String><x:String>E</x:String><x:String>F</x:String><x:String>G</x:String><x:String>H</x:String><x:String>I</x:String><x:String>J</x:String><x:String>K</x:String><x:String>L</x:String><x:String>M</x:String><x:String>N</x:String><x:String>O</x:String><x:String>P</x:String><x:String>Q</x:String><x:String>R</x:String><x:String>S</x:String><x:String>T</x:String><x:String>U</x:String><x:String>V</x:String><x:String>W</x:String><x:String>X</x:String><x:String>Y</x:String><x:String>Z</x:String><x:String>0</x:String><x:String>1</x:String><x:String>2</x:String><x:String>3</x:String><x:String>4</x:String><x:String>5</x:String><x:String>6</x:String><x:String>7</x:String><x:String>8</x:String><x:String>9</x:String><x:String>F1</x:String><x:String>F2</x:String><x:String>F3</x:String><x:String>F4</x:String><x:String>F5</x:String><x:String>F6</x:String><x:String>F7</x:String><x:String>F8</x:String><x:String>F9</x:String><x:String>F10</x:String><x:String>F11</x:String><x:String>F12</x:String><x:String>Enter</x:String><x:String>Esc</x:String><x:String>Space</x:String><x:String>Tab</x:String><x:String>Backspace</x:String><x:String>Up</x:String><x:String>Down</x:String><x:String>Left</x:String><x:String>Right</x:String><x:String>LCtrl</x:String><x:String>LShift</x:String><x:String>LAlt</x:String><x:String>LWin</x:String><x:String>RCtrl</x:String><x:String>RShift</x:String><x:String>RAlt</x:String><x:String>RWin</x:String><x:String>Home</x:String><x:String>End</x:String><x:String>PgUp</x:String><x:String>PgDn</x:String><x:String>Insert</x:String><x:String>Delete</x:String><x:String>PrintScr</x:String><x:String>Pause</x:String><x:String>VolUp</x:String><x:String>VolDown</x:String><x:String>VolMute</x:String><x:String>[</x:String><x:String>]</x:String>
                                    </ComboBox>
                                </StackPanel>
                                <Button x:Name="AddCustomShortcutButton"
                                        Content="Add Shortcut Tile"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,8,0,0"
                                        Style="{StaticResource StandaloneButtonStyle}"
                                        Click="AddCustomShortcut_Click"/>

                                <!-- Done Button -->
                                <Button Content="Done"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,16,0,0"
                                        Style="{StaticResource StandaloneButtonStyle}"
                                        Click="QuickSettingsCustomizeDone_Click"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- PERFORMANCE TAB -->
                <ScrollViewer x:Name="PerformanceScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="12,4,12,16">

                        <TextBlock Text="OVERLAY &amp; FPS" Style="{StaticResource SectionLabelStyle}" Margin="4,8,0,0"/>

                        <!-- Performance Overlay Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconChipStyle}">
                                    <FontIcon Glyph="&#xE7B3;" FontSize="18" Foreground="#C5CBD3"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Performance overlay" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock Text="FPS, CPU/GPU, RAM/VRAM, battery, time"
                                               Style="{StaticResource CardCaptionStyle}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="PerformanceOverlayToggle"
                                              Grid.Column="2"
                                              Style="{StaticResource ModernToggleStyle}"
                                              Width="52"
                                              Toggled="PerformanceOverlayToggle_Toggled"
                                              XYFocusLeft="{x:Bind PerformanceNavItem}"/>

                                <!-- Hidden slider for property system compatibility (OSDProperty binds to a Slider) -->
                                <Slider x:Name="PerformanceOverlaySlider"
                                        Visibility="Collapsed"
                                        Minimum="0" Maximum="1"
                                        Value="0"
                                        ValueChanged="PerformanceOverlaySlider_ValueChanged"/>
                            </Grid>
                        </Border>

                        <!-- FPS Limit Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconChipStyle}">
                                        <FontIcon Glyph="&#xE916;" FontSize="18" Foreground="#C5CBD3"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="FPS limit" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock x:Name="FPSLimitCaption"
                                                   Text=""
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                    <TextBlock x:Name="FPSLimitValue"
                                               Grid.Column="2"
                                               Text=""
                                               FontSize="15"
                                               Foreground="{StaticResource SystemAccentBrush}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               Visibility="{x:Bind FPSLimitToggle.IsOn, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"/>
                                    <ToggleSwitch x:Name="FPSLimitToggle"
                                                  Grid.Column="3"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False" Width="52"/>
                                </Grid>
                                <StackPanel Spacing="6" Margin="0,12,0,0"
                                            Visibility="{x:Bind FPSLimitToggle.IsOn, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                    <!-- 1.9.9a presets: set the slider below, which does the sending -->
                                    <Grid x:Name="FPSLimitPresetGrid" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Tag="30" Content="30" Style="{StaticResource QuickSegmentButtonStyle}" Height="40" Click="FPSLimitPreset_Click"/>
                                        <Button Grid.Column="1" Tag="40" Content="40" Style="{StaticResource QuickSegmentButtonStyle}" Height="40" Click="FPSLimitPreset_Click"/>
                                        <Button Grid.Column="2" Tag="45" Content="45" Style="{StaticResource QuickSegmentButtonStyle}" Height="40" Click="FPSLimitPreset_Click"/>
                                        <Button Grid.Column="3" Tag="60" Content="60" Style="{StaticResource QuickSegmentButtonStyle}" Height="40" Click="FPSLimitPreset_Click"/>
                                    </Grid>
                                    <Slider x:Name="FPSLimitSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="15" Maximum="144"
                                            StepFrequency="1"
                                            TickFrequency="15"
                                            TickPlacement="Outside"
                                            SnapsTo="StepValues"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="POWER" Style="{StaticResource SectionLabelStyle}"/>

                        <!-- AutoTDP Card (Legion only; visible regardless of TDP Mode). Continuously
                             adjusts TDP to hit a target FPS instead of a fixed wattage. Enabling it
                             forces TDP Mode to Custom and locks the mode selector until disabled. -->
                        <Border x:Name="AutoTDPCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconChipStyle}">
                                        <FontIcon Glyph="&#xE9F5;" FontSize="18" Foreground="#C5CBD3"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="AutoTDP" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Adjusts power live to hit a target FPS"
                                                   Style="{StaticResource CardCaptionStyle}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AutoTDPToggle"
                                                  Grid.Column="2"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  Width="52"
                                                  Toggled="AutoTDPToggle_Toggled"/>
                                </Grid>

                                <StackPanel x:Name="AutoTDPSettingsPanel"
                                            Spacing="10"
                                            Visibility="{Binding ElementName=AutoTDPToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <!-- Target and live FPS side by side -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource CardInsetBrush}" CornerRadius="12" Padding="12,8">
                                            <StackPanel>
                                                <TextBlock Text="Target" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock x:Name="AutoTDPTargetFPSValue" Text="60 FPS" FontSize="20" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{StaticResource CardInsetBrush}" CornerRadius="12" Padding="12,8">
                                            <StackPanel>
                                                <TextBlock Text="Now" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock x:Name="AutoTDPCurrentFPSValue" Text="-- FPS" FontSize="20" FontWeight="Bold"
                                                           Foreground="{StaticResource SystemAccentBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Target FPS" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                                    <Slider x:Name="AutoTDPTargetFPSSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="30" Maximum="144"
                                            StepFrequency="5" TickFrequency="15" TickPlacement="Outside" SnapsTo="StepValues"
                                            Value="60"
                                            ValueChanged="AutoTDPTargetFPSSlider_ValueChanged"/>

                                    <!-- Min TDP -->
                                    <Grid>
                                        <TextBlock Text="Min TDP" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AutoTDPMinValue" Text="8W" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="AutoTDPMinSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="4" Maximum="35" StepFrequency="1"
                                            Value="8"
                                            ValueChanged="AutoTDPMinSlider_ValueChanged"/>

                                    <!-- Max TDP -->
                                    <Grid>
                                        <TextBlock Text="Max TDP" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AutoTDPMaxValue" Text="30W" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="AutoTDPMaxSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="4" Maximum="35" StepFrequency="1"
                                            Value="30"
                                            ValueChanged="AutoTDPMaxSlider_ValueChanged"/>

                                    <Border Height="1" Background="#262A31" Margin="0,2,0,0"/>

                                    <!-- Pause when unfocused -->
                                    <Grid>
                                        <TextBlock Text="Pause when game isn't focused" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,60,0"/>
                                        <ToggleSwitch x:Name="AutoTDPPauseWhenUnfocusedToggle"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      Width="52"
                                                      HorizontalAlignment="Right"
                                                      IsOn="True"
                                                      Toggled="AutoTDPPauseWhenUnfocusedToggle_Toggled"/>
                                    </Grid>

                                    <!-- Fast response -->
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                            <TextBlock Text="Fast response" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="Jump to the estimated wattage when FPS is far off target, then fine-tune"
                                                       FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AutoTDPFastResponseToggle"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      Width="52"
                                                      HorizontalAlignment="Right"
                                                      IsOn="True"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- TDP Mode Card (all devices). 1.9.9a: four buttons; the ComboBox stays (hidden)
                             as the control the mode logic reads and writes. -->
                        <Border x:Name="TDPModeCard" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Text="TDP MODE" FontSize="12" FontWeight="Bold" CharacterSpacing="80"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock x:Name="PerfTdpModeHint" Text="" FontSize="12"
                                               Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PerfTdpModeQuiet" Grid.Column="0" Tag="0" Content="Quiet"
                                            Style="{StaticResource QuickSegmentButtonStyle}" Click="QuickTdpModeOption_Click"/>
                                    <Button x:Name="PerfTdpModeBalanced" Grid.Column="1" Tag="1" Content="Balanced"
                                            Style="{StaticResource QuickSegmentButtonStyle}" Click="QuickTdpModeOption_Click"/>
                                    <Button x:Name="PerfTdpModePerformance" Grid.Column="2" Tag="2" Content="Performance"
                                            Style="{StaticResource QuickSegmentButtonStyle}" FontSize="12" Click="QuickTdpModeOption_Click"/>
                                    <Button x:Name="PerfTdpModeCustom" Grid.Column="3" Tag="3" Content="Custom"
                                            Style="{StaticResource QuickSegmentButtonStyle}" Click="QuickTdpModeOption_Click"/>
                                </Grid>
                                <ComboBox x:Name="TDPModeComboBox"
                                          Visibility="Collapsed"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectedIndex="1"
                                          SelectionChanged="TDPModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Quiet" Tag="1"/>
                                    <ComboBoxItem Content="Balanced" Tag="2"/>
                                    <ComboBoxItem Content="Performance" Tag="3"/>
                                    <ComboBoxItem Content="Custom" Tag="255"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Custom Power Limits Card (Legion only, shown in Custom mode).
                             Three explicit limits written straight through Lenovo WMI:
                             TDP (base SPL), SPPT Boost (effective SPPT = TDP + boost), FPPT Boost
                             (effective FPPT = TDP + boost). Boost is always on. The live hardware
                             readout sits at the bottom of this card. -->
                        <Border x:Name="CustomTDPCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Custom power limits" Style="{StaticResource CardTitleStyle}"/>

                                <!-- TDP (base SPL / sustained) -->
                                <Grid>
                                    <TextBlock Text="TDP (sustained)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CustomTDPSlowValue" Text="-- W" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="CustomTDPSlowSlider"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Minimum="5" Maximum="35"
                                        TickFrequency="1"
                                        SnapsTo="Ticks"
                                        Value="15"
                                        ValueChanged="CustomTDPSlowSlider_ValueChanged"/>

                                <!-- SPPT Boost (effective SPPT = TDP + boost) -->
                                <Grid>
                                    <TextBlock Text="SPPT boost" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CustomTDPFastValue" Text="-- W" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="CustomTDPFastSlider"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Minimum="0" Maximum="10"
                                        TickFrequency="1"
                                        SnapsTo="Ticks"
                                        Value="2"
                                        ValueChanged="CustomTDPFastSlider_ValueChanged"/>

                                <!-- FPPT Boost (effective FPPT = TDP + boost; must be >= SPPT boost) -->
                                <Grid>
                                    <TextBlock Text="FPPT boost" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CustomTDPPeakValue" Text="-- W" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="CustomTDPPeakSlider"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Minimum="0" Maximum="15"
                                        TickFrequency="1"
                                        SnapsTo="Ticks"
                                        Value="5"
                                        ValueChanged="CustomTDPPeakSlider_ValueChanged"/>

                                <!-- Live hardware readout (helper pushes the actual SPL/SPPT/FPPT) -->
                                <Border Background="{StaticResource CardInsetBrush}" CornerRadius="10" Padding="12,8" Margin="0,4,0,0">
                                    <Grid>
                                        <TextBlock x:Name="CurrentTDPText"
                                                   Text="Limits:"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="CurrentTDPValueText"
                                                   Text="-- W"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="WINDOWS &amp; CPU" Style="{StaticResource SectionLabelStyle}"/>

                        <!-- OS Power Mode Card. 1.9.9a: three buttons; the ComboBox stays (hidden) as the
                             control the power-mode logic reads and writes. -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Text="Windows power mode" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock x:Name="OSPowerModeValue"
                                               Text="Balanced"
                                               FontSize="14"
                                               Foreground="{StaticResource SystemAccentBrush}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Grid>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="OSPowerModeEfficiencyButton" Grid.Column="0" Tag="0" Content="Efficiency"
                                            Style="{StaticResource QuickSegmentButtonStyle}" Click="OSPowerModeButton_Click"/>
                                    <Button x:Name="OSPowerModeBalancedButton" Grid.Column="1" Tag="1" Content="Balanced"
                                            Style="{StaticResource QuickSegmentButtonStyle}" Click="OSPowerModeButton_Click"/>
                                    <Button x:Name="OSPowerModePerformanceButton" Grid.Column="2" Tag="2" Content="Performance"
                                            Style="{StaticResource QuickSegmentButtonStyle}" Click="OSPowerModeButton_Click"/>
                                </Grid>
                                <ComboBox x:Name="OSPowerModeComboBox"
                                          Visibility="Collapsed"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectedIndex="1"
                                          SelectionChanged="OSPowerModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Best Power Efficiency"/>
                                    <ComboBoxItem Content="Balanced"/>
                                    <ComboBoxItem Content="Best Performance"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- CPU Extras Card (Collapsible) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CPU Extras" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="CPU Boost, EPP, and State limits"
                                                   Style="{StaticResource CardCaptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="CPUExtrasExpandToggle"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="CPUExtrasExpandToggle_Click"
                                                  UseSystemFocusVisuals="True">
                                        <FontIcon x:Name="CPUExtrasExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="CPUExtrasContent" Spacing="12" Margin="0,12,0,0" Visibility="Collapsed">
                                    <!-- CPU Boost -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="CPU Boost" FontSize="13" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Higher boost clocks" FontSize="11" Foreground="#888888"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="CPUBoostToggle"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      Grid.Column="1"
                                                      IsEnabled="False"/>
                                    </Grid>

                                    <!-- CPU EPP -->
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="CPU EPP" FontSize="13" Foreground="#FFFFFF"/>
                                            <TextBlock x:Name="CPUEPPValueText"
                                                       Text="{Binding ElementName=CPUEPPSlider, Path=Value}"
                                                       Style="{StaticResource CardValueStyle}"/>
                                        </Grid>
                                        <Slider x:Name="CPUEPPSlider"
                                                Style="{StaticResource ModernSliderStyle}"
                                                Minimum="0" Maximum="100"
                                                TickFrequency="10"
                                                SnapsTo="Ticks"
                                                TickPlacement="BottomRight"
                                                IsEnabled="False"/>
                                        <Grid Margin="0,4,0,0">
                                            <TextBlock Text="0 = Prioritize CPU" FontSize="12" Foreground="#B9C0CC"/>
                                            <TextBlock Text="100 = Prioritize GPU" FontSize="12" Foreground="#B9C0CC" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- CPU State -->
                                    <StackPanel>
                                        <TextBlock Text="CPU State" FontSize="13" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Processor performance limits" FontSize="11" Foreground="#888888"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Min %" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="MinCPUStateComboBox"
                                                          Style="{StaticResource ModernComboBoxStyle}"
                                                          SelectionChanged="MinCPUStateComboBox_SelectionChanged"
                                                          IsEnabled="False"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="Max %" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="MaxCPUStateComboBox"
                                                          Style="{StaticResource ModernComboBoxStyle}"
                                                          SelectionChanged="MaxCPUStateComboBox_SelectionChanged"
                                                          IsEnabled="False"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- GAME TAB -->
                <ScrollViewer x:Name="GameScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="12,4,12,16">

                        <!-- 1.9.9a "Now playing" card: the running game, the per-game profile switch, the
                             active profile and quick buttons for the main settings (each one runs the
                             same action as its Quick Settings tile, see GamingWidget.ProfileQuickButtons). -->
                        <Border x:Name="ActiveProfileCard" Style="{StaticResource CardStyle}" Padding="16">
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="60" Height="60" CornerRadius="14" Background="#2C313A" VerticalAlignment="Center">
                                        <Grid>
                                            <FontIcon Glyph="&#xE7FC;" FontSize="26" Foreground="{StaticResource SystemAccentBrush}"/>
                                            <Image x:Name="CurrentGameIcon"
                                                   Width="60" Height="60"
                                                   Stretch="UniformToFill"
                                                   Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="NOW PLAYING" FontSize="12" FontWeight="Bold" CharacterSpacing="80"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="RunningGameText"
                                                   Text="No game detected"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="CurrentGameProfileStatus"
                                                   Text=""
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{StaticResource CardInsetBrush}" CornerRadius="12" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Use a profile for this game" FontSize="15" FontWeight="Bold"/>
                                            <!--
                                                Detected-game name next to the per-game toggle. Wrapped in a
                                                Canvas so long window titles marquee-scroll instead of
                                                truncating (UpdateMarqueeScrollAnimation).
                                            -->
                                            <Canvas x:Name="DetectedGameTextCanvas"
                                                    Height="16"
                                                    MaxWidth="220"
                                                    Margin="0,2,0,0"
                                                    HorizontalAlignment="Left">
                                                <Canvas.Clip>
                                                    <RectangleGeometry Rect="0,0,220,16"/>
                                                </Canvas.Clip>
                                                <TextBlock x:Name="DetectedGameText"
                                                           Text="No game detected"
                                                           FontSize="12"
                                                           Foreground="{StaticResource MutedTextBrush}">
                                                    <TextBlock.RenderTransform>
                                                        <TranslateTransform x:Name="DetectedGameTextTransform"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Canvas>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="PerGameProfileToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsEnabled="False"/>
                                    </Grid>
                                </Border>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="ACTIVE PROFILE" FontSize="12" FontWeight="Bold" CharacterSpacing="80"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <!--
                                        Active profile name. Wrapped in a Canvas so long names
                                        marquee-scroll instead of truncating with an ellipsis.
                                    -->
                                    <Canvas x:Name="ActiveProfileTextCanvas"
                                            Height="22"
                                            HorizontalAlignment="Stretch">
                                        <Canvas.Clip>
                                            <RectangleGeometry Rect="0,0,0,22"/>
                                        </Canvas.Clip>
                                        <TextBlock x:Name="ActiveProfileText"
                                                   Text="Global Settings"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource SystemAccentBrush}">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform x:Name="ActiveProfileTextTransform"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Canvas>
                                </StackPanel>

                                <!-- Quick buttons: tap to change the setting (same action as its tile) -->
                                <Grid x:Name="ProfileQuickButtonsGrid" ColumnSpacing="6" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Grid.Column="0" Tag="TDPMode" Style="{StaticResource ProfileQuickButtonStyle}" Click="ProfileQuickButton_Click">
                                        <StackPanel><TextBlock Text="TDP" Style="{StaticResource ProfileQuickLabelStyle}"/><TextBlock x:Name="ProfileQuickTdpText" Text="--" Style="{StaticResource ProfileQuickValueStyle}"/></StackPanel>
                                    </Button>
                                    <Button Grid.Row="0" Grid.Column="1" Tag="AutoTDP" Style="{StaticResource ProfileQuickButtonStyle}" Click="ProfileQuickButton_Click">
                                        <StackPanel><TextBlock Text="AutoTDP" Style="{StaticResource ProfileQuickLabelStyle}"/><TextBlock x:Name="ProfileQuickAutoTdpText" Text="--" Style="{StaticResource ProfileQuickValueStyle}"/></StackPanel>
                                    </Button>
                                    <Button Grid.Row="0" Grid.Column="2" Tag="FPSLimit" Style="{StaticResource ProfileQuickButtonStyle}" Click="ProfileQuickButton_Click">
                                        <StackPanel><TextBlock Text="FPS limit" Style="{StaticResource ProfileQuickLabelStyle}"/><TextBlock x:Name="ProfileQuickFpsText" Text="--" Style="{StaticResource ProfileQuickValueStyle}"/></StackPanel>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="0" Tag="Overlay" Style="{StaticResource ProfileQuickButtonStyle}" Click="ProfileQuickButton_Click">
                                        <StackPanel><TextBlock Text="Overlay" Style="{StaticResource ProfileQuickLabelStyle}"/><TextBlock x:Name="ProfileQuickOverlayText" Text="--" Style="{StaticResource ProfileQuickValueStyle}"/></StackPanel>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="1" Tag="PowerMode" Style="{StaticResource ProfileQuickButtonStyle}" Click="ProfileQuickButton_Click">
                                        <StackPanel><TextBlock Text="Power mode" Style="{StaticResource ProfileQuickLabelStyle}"/><TextBlock x:Name="ProfileQuickPowerModeText" Text="--" Style="{StaticResource ProfileQuickValueStyle}"/></StackPanel>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="2" Tag="CPUBoost" Style="{StaticResource ProfileQuickButtonStyle}" Click="ProfileQuickButton_Click">
                                        <StackPanel><TextBlock Text="CPU boost" Style="{StaticResource ProfileQuickLabelStyle}"/><TextBlock x:Name="ProfileQuickCpuBoostText" Text="--" Style="{StaticResource ProfileQuickValueStyle}"/></StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Tap a setting to change it." FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="2,-6,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="GLOBAL PROFILE" Style="{StaticResource SectionLabelStyle}"/>


                        <!-- Global Profile Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Settings table — Win11-style info table, matching the Legion tab's
                                     Controller Information table (boxed on PageBackgroundBrush, thin
                                     separators between rows, Auto+* columns, SemiBold right-aligned values).
                                     No redundant title here — the "Global Profile" section header above
                                     this card already identifies it. -->

                                <!-- Simple Mode (Power Source Toggle OFF). Padding bottom=8 compensates
                                     for the last visible row's separator being hidden dynamically by
                                     UpdateLastVisibleSeparator (see GamingWidget.ProfileDisplay.cs) so a
                                     partially-filled profile (only some categories saved) doesn't show a
                                     stray separator flush against the box's bottom edge. -->
                                <Border x:Name="GlobalProfileSimple" Background="{StaticResource CardInsetBrush}" CornerRadius="6" Padding="12,2,12,8">
                                    <StackPanel>
                                        <StackPanel x:Name="GlobalProfileTDPModeRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="TDP Mode" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="GlobalProfileTDPModeText" Text="Balanced" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border x:Name="GlobalProfileTDPModeSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <StackPanel x:Name="GlobalProfileTDPRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="TDP" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="GlobalProfileTDPText" Text="15W" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border x:Name="GlobalProfileTDPSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <StackPanel x:Name="GlobalProfileCPUBoostRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="CPU Boost" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="GlobalProfileCPUBoostText" Text="Off" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border x:Name="GlobalProfileCPUBoostSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <StackPanel x:Name="GlobalProfileCPUEPPRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="CPU EPP" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="GlobalProfileCPUEPPText" Text="0" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border x:Name="GlobalProfileCPUEPPSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <StackPanel x:Name="GlobalProfileCPUStateRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="CPU State" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="GlobalProfileCPUStateText" Text="5-100%" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border x:Name="GlobalProfileCPUStateSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <StackPanel x:Name="GlobalProfileFPSLimitRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="FPS Limit" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="GlobalProfileFPSLimitText" Text="Off" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border x:Name="GlobalProfileFPSLimitSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <StackPanel x:Name="GlobalProfilePowerModeRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Power Mode" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="GlobalProfilePowerModeText" Text="Balanced" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border x:Name="GlobalProfilePowerModeSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <StackPanel x:Name="GlobalProfileOverlayLevelRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Overlay Level" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="GlobalProfileOverlayLevelText" Text="Off" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border x:Name="GlobalProfileOverlayLevelSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Border>

                        <!-- Game Profile Card (shown when game is detected) -->
                        <Border x:Name="GameProfileCard" Style="{StaticResource CardStyle}" Visibility="Collapsed" Margin="0,8,0,0">
                            <StackPanel>

                                <!-- Game Profile without Power Source -->
                                <StackPanel x:Name="GameProfileWithoutPowerSource">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Border Background="#005C2E"
                                                    CornerRadius="10"
                                                    Padding="6,1,6,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="Now Playing"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Foreground="#A8FFC9"/>
                                            </Border>
                                            <TextBlock x:Name="GameProfileTitleNoPower"
                                                       Text="Game"
                                                       Style="{StaticResource CardTitleStyle}"
                                                       Foreground="#FFA500"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button x:Name="DeleteActiveProfileButtonNoPower"
                                                Grid.Column="1"
                                                Content="🗑️"
                                                FontSize="12"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Background="#64FF0000"
                                                Foreground="White"
                                                BorderBrush="Transparent"
                                                BorderThickness="2"
                                                VerticalAlignment="Center"
                                                Click="DeleteActiveProfileButton_Click"/>
                                    </Grid>

                                    <!-- Settings table — Win11-style info table, matching the Legion tab's
                                         Controller Information table (boxed on PageBackgroundBrush, thin
                                         separators between rows, Auto+* columns, SemiBold right-aligned values).
                                         Padding bottom=8 compensates for the last visible row's separator
                                         being hidden dynamically by UpdateLastVisibleSeparator (see
                                         GamingWidget.ProfileDisplay.cs), since not every category is
                                         necessarily saved for a given game. -->
                                    <Border Background="{StaticResource CardInsetBrush}" CornerRadius="6" Padding="12,2,12,8" Margin="0,10,0,0">
                                        <StackPanel>
                                            <StackPanel x:Name="GameProfileTDPModeRow" Visibility="Collapsed">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="TDP Mode" FontSize="12" Foreground="#B9C0CC"/>
                                                    <TextBlock Grid.Column="1" x:Name="GameProfileTDPModeText" Text="Balanced" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Border x:Name="GameProfileTDPModeSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <StackPanel x:Name="GameProfileTDPRow" Visibility="Collapsed">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="TDP" FontSize="12" Foreground="#B9C0CC"/>
                                                    <TextBlock Grid.Column="1" x:Name="GameProfileTDPText" Text="15W" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Border x:Name="GameProfileTDPSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <StackPanel x:Name="GameProfileCPUBoostRow" Visibility="Collapsed">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="CPU Boost" FontSize="12" Foreground="#B9C0CC"/>
                                                    <TextBlock Grid.Column="1" x:Name="GameProfileCPUBoostText" Text="Off" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Border x:Name="GameProfileCPUBoostSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <StackPanel x:Name="GameProfileCPUEPPRow" Visibility="Collapsed">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="CPU EPP" FontSize="12" Foreground="#B9C0CC"/>
                                                    <TextBlock Grid.Column="1" x:Name="GameProfileCPUEPPText" Text="0" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Border x:Name="GameProfileCPUEPPSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <StackPanel x:Name="GameProfileCPUStateRow" Visibility="Collapsed">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="CPU State" FontSize="12" Foreground="#B9C0CC"/>
                                                    <TextBlock Grid.Column="1" x:Name="GameProfileCPUStateText" Text="5-100%" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Border x:Name="GameProfileCPUStateSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <StackPanel x:Name="GameProfileFPSLimitRow" Visibility="Collapsed">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="FPS Limit" FontSize="12" Foreground="#B9C0CC"/>
                                                    <TextBlock Grid.Column="1" x:Name="GameProfileFPSLimitText" Text="Off" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Border x:Name="GameProfileFPSLimitSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <StackPanel x:Name="GameProfilePowerModeRow" Visibility="Collapsed">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Power Mode" FontSize="12" Foreground="#B9C0CC"/>
                                                    <TextBlock Grid.Column="1" x:Name="GameProfilePowerModeText" Text="Balanced" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Border x:Name="GameProfilePowerModeSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <StackPanel x:Name="GameProfileOverlayLevelRow" Visibility="Collapsed">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Overlay Level" FontSize="12" Foreground="#B9C0CC"/>
                                                    <TextBlock Grid.Column="1" x:Name="GameProfileOverlayLevelText" Text="Off" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Border x:Name="GameProfileOverlayLevelSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Saved Profiles Section -->
                        <Grid Margin="0,24,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SAVED PROFILES"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center"/>
                            <!--
                                Sort dropdown for the saved-profiles list. Selection is
                                persisted to LocalSettings["ProfileSortMode"] so it
                                survives across widget re-opens. Tags are read by the
                                C# code-behind in UpdateAllGameProfilesDisplay to drive
                                ordering.
                            -->
                            <ComboBox x:Name="ProfileSortComboBox"
                                      Grid.Column="1"
                                      Width="150"
                                      SelectionChanged="ProfileSortComboBox_SelectionChanged"
                                      Style="{StaticResource ModernComboBoxStyle}">
                                <ComboBoxItem Tag="name" Content="Name (A→Z)" IsSelected="True"/>
                                <ComboBoxItem Tag="tdp" Content="TDP (high → low)"/>
                            </ComboBox>
                        </Grid>

                        <!-- Container for dynamically created game profile cards -->
                        <StackPanel x:Name="AllGameProfilesContainer"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- SYSTEM TAB -->
                <ScrollViewer x:Name="SystemScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="12,4,12,16">

                        <!-- OSD Customization Card (Collapsible) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Header with Expand/Collapse -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="OSD Customization" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Customize overlay appearance and content"
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="OSDCustomizeExpandButton"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="OSDCustomizeExpandButton_Click"
                                                  XYFocusUp="{x:Bind SystemNavItem}"
                                                  UseSystemFocusVisuals="True">
                                        <FontIcon x:Name="OSDCustomizeExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>

                                <!-- Collapsible Content -->
                                <StackPanel x:Name="OSDCustomizeContent" Visibility="Collapsed" Margin="0,12,0,0">

                                    <!-- OSD Provider Selection -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="OSD Provider"
                                                       Foreground="#B9C0CC"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"/>
                                            <TextBlock Text="Select overlay source"
                                                       Foreground="#888888"
                                                       FontSize="11"/>
                                        </StackPanel>
                                        <ComboBox x:Name="OSDProviderComboBox"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  Width="120"
                                                  Grid.Column="1"
                                                  SelectionChanged="OSDProviderComboBox_SelectionChanged"
                                                  UseSystemFocusVisuals="True"
                                                  FocusVisualPrimaryBrush="White"
                                                  FocusVisualSecondaryBrush="Transparent">
                                            <ComboBoxItem Content="RTSS" Tag="0" IsSelected="True"/>
                                            <ComboBoxItem Content="AMD" Tag="1"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- RTSS-specific options (hidden when AMD provider is selected) -->
                                    <StackPanel x:Name="RTSSOptionsPanel">
                                        <!-- Layout Settings Section -->
                                    <Border Height="1" Background="#33FFFFFF" Margin="0,4,0,12"/>
                                    <TextBlock Text="Layout"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#B9C0CC"
                                               Margin="0,0,0,8"/>

                                    <!-- Style: Modern (calmer type, soft colors, fixed-width numbers) or Classic -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Modern style" Foreground="#B9C0CC" FontSize="13"/>
                                            <TextBlock Text="Small labels and units, soft colors, steady numbers. Off = classic look."
                                                       Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="OSDModernStyleToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsOn="True"
                                                      Toggled="OSDModernStyleToggle_Toggled"/>
                                    </Grid>

                                    <!-- Columns -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Columns"
                                                       Foreground="#B9C0CC"
                                                       FontSize="13"/>
                                            <TextBlock Text="Items per row (1 = vertical list)"
                                                       Foreground="#888888"
                                                       FontSize="11"/>
                                        </StackPanel>
                                        <ComboBox x:Name="OSDColumnsComboBox"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  Width="80"
                                                  Grid.Column="1"
                                                  SelectionChanged="OSDLayoutOption_Changed"
                                                  UseSystemFocusVisuals="True"
                                                  FocusVisualPrimaryBrush="White">
                                            <ComboBoxItem Content="1" Tag="1"/>
                                            <ComboBoxItem Content="2" Tag="2"/>
                                            <ComboBoxItem Content="3" Tag="3" IsSelected="True"/>
                                            <ComboBoxItem Content="4" Tag="4"/>
                                            <ComboBoxItem Content="5" Tag="5"/>
                                            <ComboBoxItem Content="6" Tag="6"/>
                                            <ComboBoxItem Content="7" Tag="7"/>
                                            <ComboBoxItem Content="8" Tag="8"/>
                                            <ComboBoxItem Content="9" Tag="9"/>
                                            <ComboBoxItem Content="10" Tag="10"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Text Size -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Text Size"
                                                   Foreground="#B9C0CC"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"/>
                                        <ComboBox x:Name="OSDTextSizeComboBox"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  Width="100"
                                                  Grid.Column="1"
                                                  SelectionChanged="OSDLayoutOption_Changed"
                                                  UseSystemFocusVisuals="True"
                                                  FocusVisualPrimaryBrush="White">
                                            <ComboBoxItem Content="Small" Tag="50"/>
                                            <ComboBoxItem Content="Medium" Tag="100" IsSelected="True"/>
                                            <ComboBoxItem Content="Large" Tag="150"/>
                                            <ComboBoxItem Content="X-Large" Tag="200"/>
                                            <ComboBoxItem Content="XX-Large" Tag="250"/>
                                            <ComboBoxItem Content="XXX-Large" Tag="300"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Colors Section -->
                                    <Border Height="1" Background="#33FFFFFF" Margin="0,8,0,12"/>
                                    <TextBlock Text="Colors"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#B9C0CC"
                                               Margin="0,0,0,8"/>

                                    <!-- Text Color -->
                                    <StackPanel x:Name="OSDTextColorCard" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Text Color" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="13"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox x:Name="OSDTextColorDynamicCheckBox"
                                                          Content="Dynamic"
                                                          IsChecked="True"
                                                          Foreground="#B9C0CC"
                                                          FontSize="11"
                                                          Margin="0,0,8,0"
                                                          Checked="OSDTextColorDynamic_Changed"
                                                          Unchecked="OSDTextColorDynamic_Changed"/>
                                                <Border x:Name="OSDTextColorPreview"
                                                        Width="24" Height="24"
                                                        CornerRadius="4"
                                                        Background="White"
                                                        BorderBrush="#50555C"
                                                        BorderThickness="1"
                                                        Margin="0,0,8,0"/>
                                                <Button x:Name="OSDTextColorExpandButton"
                                                        Content="&#xE70D;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="12"
                                                        Padding="8,4"
                                                        Background="Transparent"
                                                        Click="OSDTextColorExpandButton_Click"
                                                        UseSystemFocusVisuals="True"
                                                        FocusVisualPrimaryBrush="White"/>
                                            </StackPanel>
                                        </Grid>
                                        <muxc:ColorPicker x:Name="OSDTextColorPicker"
                                                     Visibility="Collapsed"
                                                     Margin="0,12,0,0"
                                                     Color="White"
                                                     ColorSpectrumShape="Box"
                                                     IsMoreButtonVisible="False"
                                                     IsColorSliderVisible="False"
                                                     IsColorChannelTextInputVisible="False"
                                                     IsHexInputVisible="False"
                                                     IsAlphaEnabled="False"
                                                     IsAlphaSliderVisible="False"
                                                     IsAlphaTextInputVisible="False"
                                                     ColorChanged="OSDTextColorPicker_ColorChanged"/>
                                    </StackPanel>

                                    <!-- Label Color (Global) -->
                                    <StackPanel x:Name="OSDLabelColorCard" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Label Color" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="13"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox x:Name="OSDLabelColorDefaultCheckBox"
                                                          Content="Default"
                                                          IsChecked="True"
                                                          Foreground="#B9C0CC"
                                                          FontSize="11"
                                                          Margin="0,0,8,0"
                                                          Checked="OSDLabelColorDefault_Changed"
                                                          Unchecked="OSDLabelColorDefault_Changed"/>
                                                <Border x:Name="OSDLabelColorPreview"
                                                        Width="24" Height="24"
                                                        CornerRadius="4"
                                                        Background="#00FFFF"
                                                        BorderBrush="#50555C"
                                                        BorderThickness="1"
                                                        Margin="0,0,8,0"/>
                                                <Button x:Name="OSDLabelColorExpandButton"
                                                        Content="&#xE70D;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="12"
                                                        Padding="8,4"
                                                        Background="Transparent"
                                                        Click="OSDLabelColorExpandButton_Click"
                                                        UseSystemFocusVisuals="True"
                                                        FocusVisualPrimaryBrush="White"/>
                                            </StackPanel>
                                        </Grid>
                                        <muxc:ColorPicker x:Name="OSDLabelColorPicker"
                                                     Visibility="Collapsed"
                                                     Margin="0,12,0,0"
                                                     Color="#00FFFF"
                                                     ColorSpectrumShape="Box"
                                                     IsMoreButtonVisible="False"
                                                     IsColorSliderVisible="False"
                                                     IsColorChannelTextInputVisible="False"
                                                     IsHexInputVisible="False"
                                                     IsAlphaEnabled="False"
                                                     IsAlphaSliderVisible="False"
                                                     IsAlphaTextInputVisible="False"
                                                     ColorChanged="OSDLabelColorPicker_ColorChanged"/>
                                    </StackPanel>

                                    <!-- OSD Opacity Slider (for OLED protection) -->
                                    <StackPanel Margin="0,8,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="OSD Opacity" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="13"/>
                                            <TextBlock x:Name="OSDOpacityValue"
                                                       Grid.Column="1"
                                                       Text="50%" FontSize="13" Foreground="{StaticResource SystemAccentBrush}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Reduce OSD brightness to protect OLED pixels" Foreground="#888888" FontSize="11" Margin="0,2,0,4"/>
                                        <Slider x:Name="OSDOpacitySlider"
                                                Style="{StaticResource ModernSliderStyle}"
                                                Minimum="10" Maximum="100"
                                                TickFrequency="5"
                                                SnapsTo="Ticks"
                                                Value="50"
                                                ValueChanged="OSDOpacitySlider_ValueChanged"/>
                                    </StackPanel>

                                    <!-- Position Shift Toggle (OLED burn-in protection) -->
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Position Shift" Foreground="#B9C0CC" FontSize="13"/>
                                            <TextBlock Text="Shifts OSD every minute to prevent burn-in" Foreground="#888888" FontSize="11"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="OSDPositionShiftToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      Toggled="OSDPositionShiftToggle_Toggled"/>
                                    </Grid>

                                    <!-- Frametime Graph Pinned Toggle -->
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Pin Frametime Graph" Foreground="#B9C0CC" FontSize="13"/>
                                            <TextBlock Text="Always display graph on its own row at bottom" Foreground="#888888" FontSize="11"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="FrametimeGraphPinnedToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      Toggled="FrametimeGraphPinnedToggle_Toggled"/>
                                    </Grid>

                                        <!-- Items Section -->
                                        <Border Height="1" Background="#33FFFFFF" Margin="0,8,0,12"/>
                                        <TextBlock Text="Items to Display"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#B9C0CC"
                                                   Margin="0,0,0,8"/>

                                        <!-- OSD Items with reordering -->
                                        <ItemsControl x:Name="OSDItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0"
                                                                  Content="{Binding DisplayName}"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  Foreground="#B9C0CC"
                                                                  Tag="{Binding Id}"
                                                                  UseSystemFocusVisuals="True"
                                                                  FocusVisualPrimaryBrush="White"
                                                                  FocusVisualSecondaryBrush="Transparent"
                                                                  Checked="OSDItemCheckBox_Changed"
                                                                  Unchecked="OSDItemCheckBox_Changed"/>

                                                        <Button Grid.Column="1"
                                                                Content="&#xE70E;"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                FontSize="10"
                                                                Width="28" Height="24"
                                                                Padding="0"
                                                                Margin="4,0,0,0"
                                                                Background="Transparent"
                                                                Tag="{Binding Id}"
                                                                IsEnabled="{Binding CanMoveUp}"
                                                                Click="OSDItemMoveUp_Click"/>

                                                        <Button Grid.Column="2"
                                                                Content="&#xE70D;"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                FontSize="10"
                                                                Width="28" Height="24"
                                                                Padding="0"
                                                                Margin="4,0,0,0"
                                                                Background="Transparent"
                                                                Tag="{Binding Id}"
                                                                IsEnabled="{Binding CanMoveDown}"
                                                                Click="OSDItemMoveDown_Click"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Custom RTSS Tags Section -->
                                        <Border Height="1" Background="#33FFFFFF" Margin="0,12,0,12"/>
                                        <TextBlock Text="Custom RTSS Tags"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#B9C0CC"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="Add custom RTSS tags (e.g. &lt;FR&gt; for FPS)"
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   Margin="0,0,0,8"/>
                                        <TextBox x:Name="OSDCustomTagsTextBox"
                                                 PlaceholderText="Enter custom RTSS tags..."
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 Height="60"
                                                 TextChanged="OSDCustomTagsTextBox_TextChanged"/>
                                    </StackPanel>

                                    <!-- AMD-specific info (shown when AMD provider is selected) -->
                                    <StackPanel x:Name="AMDOptionsPanel" Visibility="Collapsed">
                                        <TextBlock Text="AMD Adrenaline Overlay"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#B9C0CC"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="The AMD overlay is controlled through Adrenaline software. Use Ctrl+Shift+O to toggle and Ctrl+Shift+X to cycle overlay levels."
                                                   Foreground="#B9C0CC"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Power & Sleep Card (Collapsible): power button behavior + screen/hibernate
                             idle timers, merged under one expandable card matching Windows' own
                             "Power & sleep" settings grouping. Power Button + Display Timeout are
                             pulled directly from the active Windows power plan; Hibernate Timeout is
                             a GoTweaks-only feature (see its section note below). -->
                        <Border x:Name="PowerAndSleepCard" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Power &amp; Sleep" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Power button behavior and idle timers"
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="PowerAndSleepExpandButton"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="PowerAndSleepExpandButton_Click">
                                        <FontIcon x:Name="PowerAndSleepExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>

                                <StackPanel x:Name="PowerAndSleepContent" Visibility="Collapsed" Margin="0,12,0,0">

                                    <TextBlock Text="Power button" FontSize="13" FontWeight="SemiBold" Foreground="#B9C0CC"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Plugged in (AC)" FontSize="13" Foreground="White" VerticalAlignment="Center" Grid.Column="0"/>
                                        <ComboBox x:Name="PowerButtonActionACComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem Content="Sleep" Tag="1"/>
                                            <ComboBoxItem Content="Hibernate" Tag="2"/>
                                            <ComboBoxItem Content="Do nothing" Tag="0"/>
                                            <ComboBoxItem Content="Shut down" Tag="3"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="On battery (DC)" FontSize="13" Foreground="White" VerticalAlignment="Center" Grid.Column="0"/>
                                        <ComboBox x:Name="PowerButtonActionDCComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem Content="Sleep" Tag="1"/>
                                            <ComboBoxItem Content="Hibernate" Tag="2"/>
                                            <ComboBoxItem Content="Do nothing" Tag="0"/>
                                            <ComboBoxItem Content="Shut down" Tag="3"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Margin="0,14,0,0" Height="1" Background="#22FFFFFF"/>

                                    <TextBlock Text="Turn off screen after" FontSize="13" FontWeight="SemiBold" Foreground="#B9C0CC" Margin="0,12,0,0"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Plugged in (AC)" FontSize="13" Foreground="White" VerticalAlignment="Center" Grid.Column="0"/>
                                        <ComboBox x:Name="DisplayTimeoutACComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem Content="Never" Tag="0"/>
                                            <ComboBoxItem Content="1 minute" Tag="60"/>
                                            <ComboBoxItem Content="2 minutes" Tag="120"/>
                                            <ComboBoxItem Content="3 minutes" Tag="180"/>
                                            <ComboBoxItem Content="5 minutes" Tag="300"/>
                                            <ComboBoxItem Content="10 minutes" Tag="600"/>
                                            <ComboBoxItem Content="15 minutes" Tag="900"/>
                                            <ComboBoxItem Content="20 minutes" Tag="1200"/>
                                            <ComboBoxItem Content="30 minutes" Tag="1800"/>
                                            <ComboBoxItem Content="45 minutes" Tag="2700"/>
                                            <ComboBoxItem Content="1 hour" Tag="3600"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="On battery (DC)" FontSize="13" Foreground="White" VerticalAlignment="Center" Grid.Column="0"/>
                                        <ComboBox x:Name="DisplayTimeoutDCComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem Content="Never" Tag="0"/>
                                            <ComboBoxItem Content="1 minute" Tag="60"/>
                                            <ComboBoxItem Content="2 minutes" Tag="120"/>
                                            <ComboBoxItem Content="3 minutes" Tag="180"/>
                                            <ComboBoxItem Content="5 minutes" Tag="300"/>
                                            <ComboBoxItem Content="10 minutes" Tag="600"/>
                                            <ComboBoxItem Content="15 minutes" Tag="900"/>
                                            <ComboBoxItem Content="20 minutes" Tag="1200"/>
                                            <ComboBoxItem Content="30 minutes" Tag="1800"/>
                                            <ComboBoxItem Content="45 minutes" Tag="2700"/>
                                            <ComboBoxItem Content="1 hour" Tag="3600"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Margin="0,14,0,0" Height="1" Background="#22FFFFFF"/>

                                    <TextBlock Text="Hibernate after" FontSize="13" FontWeight="SemiBold" Foreground="#B9C0CC" Margin="0,12,0,0"/>
                                    <TextBlock Text="GoTweaks feature - not a Windows setting, since Windows has no built-in idle-to-hibernate timer"
                                               FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Plugged in (AC)" FontSize="13" Foreground="White" VerticalAlignment="Center" Grid.Column="0"/>
                                        <ComboBox x:Name="HibernateTimeoutACComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem Content="Never" Tag="0"/>
                                            <ComboBoxItem Content="10 minutes" Tag="10"/>
                                            <ComboBoxItem Content="15 minutes" Tag="15"/>
                                            <ComboBoxItem Content="20 minutes" Tag="20"/>
                                            <ComboBoxItem Content="30 minutes" Tag="30"/>
                                            <ComboBoxItem Content="45 minutes" Tag="45"/>
                                            <ComboBoxItem Content="1 hour" Tag="60"/>
                                            <ComboBoxItem Content="2 hours" Tag="120"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="On battery (DC)" FontSize="13" Foreground="White" VerticalAlignment="Center" Grid.Column="0"/>
                                        <ComboBox x:Name="HibernateTimeoutDCComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem Content="Never" Tag="0"/>
                                            <ComboBoxItem Content="10 minutes" Tag="10"/>
                                            <ComboBoxItem Content="15 minutes" Tag="15"/>
                                            <ComboBoxItem Content="20 minutes" Tag="20"/>
                                            <ComboBoxItem Content="30 minutes" Tag="30"/>
                                            <ComboBoxItem Content="45 minutes" Tag="45"/>
                                            <ComboBoxItem Content="1 hour" Tag="60"/>
                                            <ComboBoxItem Content="2 hours" Tag="120"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Windows' own Sleep idle timer (Settings > Power & battery)
                                         still runs independently of the Hibernate timer above and can
                                         fire first, sending the system to Sleep before our Hibernate
                                         timeout is ever reached. This one-off button zeroes Windows'
                                         Sleep-after timeout for both AC and DC so the GoTweaks
                                         Hibernate timer above is the only idle-power action left. -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Windows' own Sleep timer can still fire first"
                                                       FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="DisableSleepTimersStatusText"
                                                       Text=""
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#6CCB5F"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="DisableSleepTimersButton"
                                                Grid.Column="1"
                                                Content="Disable Sleep Timer (AC+DC)"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Click="DisableSleepTimersButton_Click"
                                                VerticalAlignment="Center"/>
                                    </Grid>

                                    <muxc:Expander x:Name="PowerButtonInfoExpander"
                                                   Margin="0,14,0,0"
                                                   HorizontalAlignment="Stretch"
                                                   HorizontalContentAlignment="Stretch"
                                                   IsExpanded="False">
                                        <muxc:Expander.Header>
                                            <TextBlock Text="Recommendation" FontSize="12" Foreground="#B9C0CC"/>
                                        </muxc:Expander.Header>
                                        <Border Background="#3D2A1A" CornerRadius="4" Padding="10">
                                            <StackPanel>
                                                <TextBlock Foreground="#FFB060" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"
                                                           Text="⚠ Use Hibernate instead of Sleep"/>
                                                <TextBlock Foreground="#DDB890" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Text="Windows' default Sleep (Modern Standby) sometimes drains the battery from background wake-ups or fails to resume cleanly. Hibernate saves the session to disk and fully powers off, which is closer to how SteamOS suspends and tends to be more reliable - at the cost of a slightly slower resume. Setting the Power Button and Hibernate Timeout options above to Hibernate (and disabling Windows' Sleep timer) is the recommended change."/>
                                            </StackPanel>
                                        </Border>
                                    </muxc:Expander>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Debug Card (Collapsible) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Header with Expand/Collapse -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Maintenance" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Restart, logs, backup, reset"
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="DebugExpandButton"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="DebugExpandButton_Click">
                                        <FontIcon x:Name="DebugExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>

                                <!-- Collapsible Content -->
                                <!-- 1.9.9a: maintenance tools as a two-column grid of large buttons -->
                                <Grid x:Name="DebugContent" Visibility="Collapsed" Margin="0,12,0,0" ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Button x:Name="RestartHelperButton" Grid.Row="0" Grid.Column="0" Content="Restart Helper" Height="52" CornerRadius="12" Style="{StaticResource StandaloneButtonStyle}" Click="RestartHelperButton_Click"/>
                                    <Button x:Name="KillGoTweaksButton" Grid.Row="0" Grid.Column="1" Content="Kill GoTweaks Lite" Height="52" CornerRadius="12" Style="{StaticResource StandaloneButtonStyle}" Click="KillGoTweaksButton_Click"/>
                                    <Button x:Name="ExportLogsButton" Grid.Row="1" Grid.Column="0" Content="Export Logs" Height="52" CornerRadius="12" Style="{StaticResource StandaloneButtonStyle}" Click="ExportLogsButton_Click"/>
                                    <Button x:Name="ExportAllDataButton" Grid.Row="1" Grid.Column="1" Content="Export All Data" Height="52" CornerRadius="12" Style="{StaticResource StandaloneButtonStyle}" Click="ExportAllDataButton_Click"/>
                                    <Button x:Name="ImportAllDataButton" Grid.Row="2" Grid.Column="0" Content="Import All Data" Height="52" CornerRadius="12" Style="{StaticResource StandaloneButtonStyle}" Click="ImportAllDataButton_Click"/>
                                    <!-- Reset All Settings: backs up to the Desktop, then puts every GoTweaks setting back to default -->
                                    <Button x:Name="ResetAllSettingsButton" Grid.Row="2" Grid.Column="1" Content="Reset All Settings" Height="52" CornerRadius="12" Foreground="#FF8A80" Style="{StaticResource StandaloneButtonStyle}" Click="ResetAllSettingsButton_Click"/>
                                    <Button x:Name="PrepareForUninstallButton" Grid.Row="3" Grid.ColumnSpan="2" Content="Prepare for Uninstall" Height="52" CornerRadius="12" Foreground="#FF8A80" Style="{StaticResource StandaloneButtonStyle}" Click="PrepareForUninstallButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- About Card (Collapsible) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Header with Expand/Collapse -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="About" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Version and credits"
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="AboutExpandButton"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="AboutExpandButton_Click">
                                        <FontIcon x:Name="AboutExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>

                                <!-- Collapsible Content -->
                                <StackPanel x:Name="AboutContent" Visibility="Collapsed" Margin="0,12,0,0">
                                    <!-- Updates - everything update-related lives here, at the top. -->
                                    <Button x:Name="CheckForUpdateButton"
                                            Content="Check for Update"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource StandaloneButtonStyle}"
                                            Click="CheckForUpdateButton_Click"/>

                                    <!-- Update Status Text -->
                                    <TextBlock x:Name="UpdateStatusText"
                                               Text=""
                                               FontSize="12"
                                               Foreground="#B9C0CC"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"
                                               Visibility="Collapsed"/>

                                    <!-- Update Button (shown when update available) -->
                                    <Button x:Name="UpdateButton"
                                            Content="Update"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,8,0,0"
                                            Style="{StaticResource StandaloneButtonStyle}"
                                            Background="#107C10"
                                            Click="UpdateButton_Click"
                                            Visibility="Collapsed"/>

                                    <!-- Single "check for updates automatically" preference, gating both
                                         update surfaces (the helper's Quick-tab banner probe and the
                                         widget's own startup auto-check) so there is only one on-screen
                                         toggle instead of two near-duplicate ones. -->
                                    <Grid Margin="0,20,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Check for updates automatically on start"
                                                   FontSize="12"
                                                   Foreground="#B9C0CC"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <ToggleSwitch x:Name="GoTweaksUpdateOnStartCheckbox"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsOn="True"
                                                      Toggled="GoTweaksUpdateOnStartCheckbox_Changed"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Hide GoTweaks Lite update banner on Quick tab"
                                                   FontSize="12"
                                                   Foreground="#B9C0CC"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <ToggleSwitch x:Name="GoTweaksHideBannerCheckbox"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsOn="False"
                                                      Toggled="GoTweaksHideBannerCheckbox_Changed"/>
                                    </Grid>

                                    <Border Height="1" Background="#33FFFFFF" Margin="0,16,0,16"/>

                                    <!-- Version -->
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Version"
                                                   FontSize="13"
                                                   Foreground="#B9C0CC"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AboutVersionText"
                                                   Text="0.3.98.0"
                                                   FontSize="14"
                                                   Foreground="#6CCB5F"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Fork Author -->
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Fork Author"
                                                   FontSize="13"
                                                   Foreground="#B9C0CC"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="RuloB"
                                                   FontSize="14"
                                                   Foreground="{StaticResource SystemAccentBrush}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Original Author -->
                                    <Grid Margin="0,0,0,0">
                                        <TextBlock Text="Original Author"
                                                   FontSize="13"
                                                   Foreground="#B9C0CC"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="LtChipotle"
                                                   FontSize="14"
                                                   Foreground="#FFFFFF"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- LEGION TAB -->
                <ScrollViewer x:Name="LegionScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="12,4,12,16">

                        <!-- Controller Status Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Left Controller / Device Glyph / Right Controller, flanking row.
                                     All three panels share the same 132px height (the glyph box is
                                     taller than the others to fit the device name inside it). Left/
                                     Right cards are individually collapsible (hidden on devices
                                     without detachable controllers) via SetControllerBatterySectionVisibility. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Controller -->
                                    <Border x:Name="LeftControllerCard" Grid.Column="0" Height="132"
                                            Background="{StaticResource CardInsetBrush}"
                                            CornerRadius="14" Padding="12,10" Margin="0,0,8,0">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Left Controller" FontSize="12" Foreground="#B9C0CC" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE83F;" FontSize="14" Foreground="#B9C0CC" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="LeftControllerBatteryText"
                                                           Text="--%"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"/>
                                                <FontIcon x:Name="LeftControllerChargingIcon"
                                                          Glyph="&#xE945;"
                                                          FontSize="12"
                                                          Foreground="#4CAF50"
                                                          Margin="6,0,0,0"
                                                          Visibility="Collapsed"/>
                                            </StackPanel>
                                            <TextBlock x:Name="LeftControllerConnectionText"
                                                       Text="--"
                                                       FontSize="11"
                                                       Foreground="#888888"
                                                       Margin="0,2,0,0"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Device Glyph + name, stacked together in one taller box -->
                                    <Border Grid.Column="1" Width="176" Height="132" CornerRadius="18"
                                            Background="{StaticResource CardInsetBrush}"
                                            Margin="8,0,8,0">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="/Assets/Glyph_LeGo2.png"
                                                   Width="136" Stretch="Uniform"
                                                   HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LegionDeviceNameText" Text="Legion Go Controller"
                                                       Style="{StaticResource CardTitleStyle}"
                                                       HorizontalAlignment="Center" TextAlignment="Center"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Right Controller -->
                                    <Border x:Name="RightControllerCard" Grid.Column="2" Height="132"
                                            Background="{StaticResource CardInsetBrush}"
                                            CornerRadius="14" Padding="12,10" Margin="8,0,0,0">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Right Controller" FontSize="12" Foreground="#B9C0CC" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE83F;" FontSize="14" Foreground="#B9C0CC" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="RightControllerBatteryText"
                                                           Text="--%"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"/>
                                                <FontIcon x:Name="RightControllerChargingIcon"
                                                          Glyph="&#xE945;"
                                                          FontSize="12"
                                                          Foreground="#4CAF50"
                                                          Margin="6,0,0,0"
                                                          Visibility="Collapsed"/>
                                            </StackPanel>
                                            <TextBlock x:Name="RightControllerConnectionText"
                                                       Text="--"
                                                       FontSize="11"
                                                       Foreground="#888888"
                                                       Margin="0,2,0,0"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Separator under the title -->
                                <Border Height="1" Background="#33FFFFFF" Margin="0,10,0,0"/>

                                <!-- Controller Information — Win11-style info table.
                                     Visibility is driven by UpdateLegionControllerInfoSectionVisibility()
                                     (shows as soon as EITHER VID:PID or device-status JSON has data,
                                     so VID:PID isn't hidden just because the device-status readback
                                     hasn't arrived yet). -->
                                <StackPanel x:Name="LegionControllerInfoSection" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="Controller Information"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#B9C0CC"
                                               Margin="0,0,0,8"/>

                                    <Border Background="{StaticResource CardInsetBrush}" CornerRadius="6" Padding="12,2">
                                        <StackPanel>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="VID:PID" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="LegionControllerPidVidText"
                                                           Text="--" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Firmware" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="LegionControllerFirmwareText"
                                                           Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Stick light" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="LegionControllerLightText"
                                                           Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                                <Border Grid.Column="2" x:Name="LegionControllerLightSwatch"
                                                        Width="14" Height="14" CornerRadius="3"
                                                        BorderThickness="1" BorderBrush="#444444"
                                                        Visibility="Collapsed"/>
                                            </Grid>
                                            <Border Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Vibration" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="LegionControllerVibrationText"
                                                           Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>

                                            <Grid Margin="0,8,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Touchpad" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="LegionControllerTouchpadText"
                                                           Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Controller auto-sleep (idle power-off) timeout -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Controller sleep" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="13"/>
                                        <ComboBox x:Name="LegionControllerSleepComboBox" Grid.Column="1" Width="110"
                                                  Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="3"
                                                  SelectionChanged="LegionControllerSleepComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Never" Tag="0"/>
                                            <ComboBoxItem Content="5 min" Tag="5"/>
                                            <ComboBoxItem Content="10 min" Tag="10"/>
                                            <ComboBoxItem Content="15 min" Tag="15"/>
                                            <ComboBoxItem Content="20 min" Tag="20"/>
                                            <ComboBoxItem Content="30 min" Tag="30"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Controller Settings Section (Touchpad & Vibration + Lighting) -->
                        <TextBlock Text="CONTROLLER" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Controller Mode Card: Legion Space style X-Input / D-Input switch. Only shown
                             once the helper reports a controller that supports it (see
                             UpdateLegionControllerModeUI). Switch off = X-Input, on = D-Input. -->
                        <Border x:Name="LegionControllerModeCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="D-Input mode" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock x:Name="LegionControllerModeStatusText"
                                                   Text="Controllers not detected"
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LegionControllerModeToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsOn="False"
                                                  IsEnabled="False"
                                                  XYFocusUp="{x:Bind LegionNavItem}"
                                                  XYFocusDown="{x:Bind TouchpadVibrationExpandToggle}"
                                                  Toggled="LegionControllerModeToggle_Toggled"/>
                                </Grid>
                                <TextBlock Text="Same switch as Legion Space. The controllers reconnect for a few seconds, and in D-Input the Xbox / Game Bar interface may stop responding to them - use the touchscreen to switch back."
                                           FontSize="11"
                                           Foreground="#888888"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Touchpad & Vibration Card (hidden on devices without HID touchpad support) -->
                        <StackPanel x:Name="TouchpadVibrationSection">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Touchpad &amp; Vibration" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="Touchpad and haptic feedback settings"
                                                       Style="{StaticResource CardCaptionStyle}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="TouchpadVibrationExpandToggle"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="TouchpadVibrationExpandToggle_Click"
                                                  XYFocusUp="{x:Bind LegionNavItem}">
                                        <FontIcon x:Name="TouchpadVibrationExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="TouchpadVibrationContent" Spacing="12" Margin="0,12,0,0" Visibility="Collapsed">
                                    <!-- Touchpad Toggle -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Touchpad Enabled" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                        <ToggleSwitch x:Name="LegionTouchpadToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsOn="True"
                                                      XYFocusUp="{x:Bind LegionNavItem}"
                                                      XYFocusDown="{x:Bind LegionVibrationComboBox}"/>
                                    </Grid>

                                    <!-- Vibration Intensity -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Vibration Intensity" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                        <ComboBox x:Name="LegionVibrationComboBox"
                                                  Grid.Column="1"
                                                  Width="120"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectedIndex="2">
                                            <x:String>Off</x:String>
                                            <x:String>Weak</x:String>
                                            <x:String>Medium</x:String>
                                            <x:String>Strong</x:String>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Vibration Mode -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Vibration Mode" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                        <ComboBox x:Name="LegionVibrationModeComboBox"
                                                  Grid.Column="1"
                                                  Width="120"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectedIndex="0">
                                            <x:String>FPS</x:String>
                                            <x:String>Racing</x:String>
                                            <x:String>AVG</x:String>
                                            <x:String>SPG</x:String>
                                            <x:String>RPG</x:String>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Touchpad Haptics Dropdown -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Touchpad Haptics" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                        <ComboBox x:Name="LegionTouchpadVibrationComboBox"
                                                  Grid.Column="1"
                                                  SelectedIndex="2"
                                                  Width="120"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <x:String>Off</x:String>
                                            <x:String>Low</x:String>
                                            <x:String>Medium</x:String>
                                            <x:String>High</x:String>
                                        </ComboBox>
                                    </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Lighting Section (hidden on devices without HID RGB lighting support) -->
                        <!-- No dedicated header - grouped under "Controller Settings" above, with Touchpad & Vibration -->
                        <StackPanel x:Name="LightingSection">
                        <!-- Lighting Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Lighting" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Controller RGB and power button lighting"
                                                   Style="{StaticResource CardCaptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="LightingExpandToggle"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="LightingExpandToggle_Click">
                                        <FontIcon x:Name="LightingExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="LightingContent" Spacing="12" Margin="0,12,0,0" Visibility="Collapsed">
                                    <!-- Light Mode -->
                                    <StackPanel>
                                        <TextBlock Text="Light Mode" FontSize="14" Foreground="#B9C0CC" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="LegionLightModeComboBox"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  HorizontalAlignment="Stretch"
                                                  SelectedIndex="1"
                                                  SelectionChanged="LegionLightModeComboBox_SelectionChanged">
                                            <x:String>Off</x:String>
                                            <x:String>Solid</x:String>
                                            <x:String>Pulse</x:String>
                                            <x:String>Dynamic</x:String>
                                            <x:String>Spiral</x:String>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Light Color (Solid, Pulse only) -->
                                    <StackPanel x:Name="LegionColorCard">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Light Color" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border x:Name="LegionColorPreview"
                                                        Width="24" Height="24"
                                                        CornerRadius="4"

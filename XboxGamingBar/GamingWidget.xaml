                                               Foreground="#888888"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>


                        <!-- Deadzones Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Deadzones" Style="{StaticResource CardTitleStyle}" Grid.Column="0"/>
                                    <ToggleButton x:Name="StickDeadzonesExpandToggle"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="StickDeadzonesExpandToggle_Click">
                                        <FontIcon x:Name="StickDeadzonesExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="StickDeadzonesContent" Spacing="12" Margin="0,12,0,0" Visibility="Collapsed">
                                    <!-- Stick Deadzones Section -->
                                    <TextBlock Text="Stick Deadzones" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>

                                    <!-- Left Stick Deadzone -->
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Left Stick" FontSize="13" Foreground="#B9C0CC"/>
                                            <TextBlock x:Name="LegionLeftStickDeadzoneValue"
                                                       Text="4%"
                                                       Style="{StaticResource CardValueStyle}"/>
                                        </Grid>
                                        <Slider x:Name="LegionLeftStickDeadzoneSlider"
                                                Style="{StaticResource ModernSliderStyle}"
                                                Minimum="0" Maximum="50"
                                                Value="4"
                                                StepFrequency="1"/>
                                    </StackPanel>

                                    <!-- Right Stick Deadzone -->
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Right Stick" FontSize="13" Foreground="#B9C0CC"/>
                                            <TextBlock x:Name="LegionRightStickDeadzoneValue"
                                                       Text="4%"
                                                       Style="{StaticResource CardValueStyle}"/>
                                        </Grid>
                                        <Slider x:Name="LegionRightStickDeadzoneSlider"
                                                Style="{StaticResource ModernSliderStyle}"
                                                Minimum="0" Maximum="50"
                                                Value="4"
                                                StepFrequency="1"/>
                                    </StackPanel>

                                    <!-- Trigger Travel Section -->
                                    <TextBlock Text="Trigger Travel" FontSize="12" Foreground="#888888" Margin="0,16,0,4"/>

                                    <!-- Hair Triggers Toggle -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Hair Triggers" FontSize="13" Foreground="#B9C0CC" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="LegionHairTriggersToggle" Grid.Column="1" OnContent="" OffContent="" Margin="0,0,-8,0"/>
                                    </Grid>

                                    <!-- Left Trigger -->
                                    <StackPanel x:Name="LeftTriggerPanel">
                                        <TextBlock Text="Left Trigger" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Dead Zone" FontSize="13" Foreground="#B9C0CC"/>
                                                <TextBlock x:Name="LegionLeftTriggerStartValue"
                                                           Text="0%"
                                                           Style="{StaticResource CardValueStyle}"/>
                                            </Grid>
                                            <Slider x:Name="LegionLeftTriggerStartSlider"
                                                    Style="{StaticResource ModernSliderStyle}"
                                                    Minimum="0" Maximum="50"
                                                    Value="0"
                                                    StepFrequency="1"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Full Press" FontSize="13" Foreground="#B9C0CC"/>
                                                <TextBlock x:Name="LegionLeftTriggerEndValue"
                                                           Text="0%"
                                                           Style="{StaticResource CardValueStyle}"/>
                                            </Grid>
                                            <Slider x:Name="LegionLeftTriggerEndSlider"
                                                    Style="{StaticResource ModernSliderStyle}"
                                                    Minimum="0" Maximum="99"
                                                    Value="0"
                                                    StepFrequency="1"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Right Trigger -->
                                    <StackPanel x:Name="RightTriggerPanel">
                                        <TextBlock Text="Right Trigger" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Dead Zone" FontSize="13" Foreground="#B9C0CC"/>
                                                <TextBlock x:Name="LegionRightTriggerStartValue"
                                                           Text="0%"
                                                           Style="{StaticResource CardValueStyle}"/>
                                            </Grid>
                                            <Slider x:Name="LegionRightTriggerStartSlider"
                                                    Style="{StaticResource ModernSliderStyle}"
                                                    Minimum="0" Maximum="50"
                                                    Value="0"
                                                    StepFrequency="1"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Full Press" FontSize="13" Foreground="#B9C0CC"/>
                                                <TextBlock x:Name="LegionRightTriggerEndValue"
                                                           Text="0%"
                                                           Style="{StaticResource CardValueStyle}"/>
                                            </Grid>
                                            <Slider x:Name="LegionRightTriggerEndSlider"
                                                    Style="{StaticResource ModernSliderStyle}"
                                                    Minimum="0" Maximum="99"
                                                    Value="0"
                                                    StepFrequency="1"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Gyro Settings Section (hidden on devices without HID gyro support) -->
                        <StackPanel x:Name="GyroSection">
                        <!-- Gyro Settings Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Gyro Settings" Style="{StaticResource CardTitleStyle}" Grid.Column="0"/>
                                    <ToggleButton x:Name="GyroSettingsExpandToggle"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="GyroSettingsExpandToggle_Click">
                                        <FontIcon x:Name="GyroSettingsExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="GyroSettingsContent" Spacing="12" Margin="0,12,0,0" Visibility="Collapsed">
                                    <!-- Gyro Target -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Target" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                    <ComboBox x:Name="LegionGyroTargetComboBox"
                                              Grid.Column="1"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              HorizontalAlignment="Stretch"
                                              SelectedIndex="0">
                                        <x:String>Disabled</x:String>
                                        <x:String>Left Stick</x:String>
                                        <x:String>Right Stick</x:String>
                                        <x:String>Mouse</x:String>
                                    </ComboBox>
                                </Grid>

                                <!-- Gyro Sensitivity X -->
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Sensitivity X" FontSize="13" Foreground="#B9C0CC"/>
                                        <TextBlock x:Name="LegionGyroSensitivityXValue"
                                                   Text="50"
                                                   Style="{StaticResource CardValueStyle}"/>
                                    </Grid>
                                    <Slider x:Name="LegionGyroSensitivityXSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="1" Maximum="100"
                                            Value="50"
                                            StepFrequency="1"/>
                                </StackPanel>

                                <!-- Gyro Sensitivity Y -->
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Sensitivity Y" FontSize="13" Foreground="#B9C0CC"/>
                                        <TextBlock x:Name="LegionGyroSensitivityYValue"
                                                   Text="50"
                                                   Style="{StaticResource CardValueStyle}"/>
                                    </Grid>
                                    <Slider x:Name="LegionGyroSensitivityYSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="1" Maximum="100"
                                            Value="50"
                                            StepFrequency="1"/>
                                </StackPanel>

                                <!-- Gyro Deadzone -->
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Deadzone" FontSize="13" Foreground="#B9C0CC"/>
                                        <TextBlock x:Name="LegionGyroDeadzoneValue"
                                                   Text="10"
                                                   Style="{StaticResource CardValueStyle}"/>
                                    </Grid>
                                    <Slider x:Name="LegionGyroDeadzoneSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="1" Maximum="100"
                                            Value="10"
                                            StepFrequency="1"/>
                                </StackPanel>

                                <!-- Gyro Invert X/Y Toggles -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="Invert X" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" Margin="0,0,12,0"/>
                                        <ToggleSwitch x:Name="LegionGyroInvertXToggle"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsOn="False"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Invert Y" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" Margin="0,0,12,0"/>
                                        <ToggleSwitch x:Name="LegionGyroInvertYToggle"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsOn="False"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Gyro Mapping Type -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mapping" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                    <ComboBox x:Name="LegionGyroMappingTypeComboBox"
                                              Grid.Column="1"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              HorizontalAlignment="Stretch"
                                              SelectedIndex="0">
                                        <x:String>Instant</x:String>
                                        <x:String>Continuous</x:String>
                                    </ComboBox>
                                </Grid>

                                <!-- Gyro Activation Mode -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Activation" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                    <ComboBox x:Name="LegionGyroActivationModeComboBox"
                                              Grid.Column="1"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              HorizontalAlignment="Stretch"
                                              SelectedIndex="0">
                                        <x:String>Hold</x:String>
                                        <x:String>Toggle</x:String>
                                    </ComboBox>
                                </Grid>

                                <!-- Gyro Activation Button -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Button" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                    <ComboBox x:Name="LegionGyroActivationButtonComboBox"
                                              Grid.Column="1"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              HorizontalAlignment="Stretch"
                                              SelectedIndex="0">
                                        <x:String>None</x:String>
                                        <x:String>LB</x:String>
                                        <x:String>LT</x:String>
                                        <x:String>RB</x:String>
                                        <x:String>RT</x:String>
                                        <x:String>Y1</x:String>
                                        <x:String>Y2</x:String>
                                        <x:String>M2</x:String>
                                        <x:String>M3</x:String>
                                    </ComboBox>
                                </Grid>

                                <!-- Gyro Calibration -->
                                <StackPanel Margin="0,4,0,0">
                                    <Button x:Name="LegionCalibrateGyroButton"
                                            Content="Calibrate gyro"
                                            Style="{StaticResource ModernButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Click="LegionCalibrateGyroButton_Click"/>
                                    <TextBlock x:Name="LegionCalibrateGyroStatus"
                                               Text="Hold the controllers still and press the button — bias is captured by the controller firmware."
                                               FontSize="11"
                                               Foreground="#888888"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                        <!-- End Gyro Section -->


                        </StackPanel>
                        <!-- End Controller Remapping Section -->

                        <!-- Fan Settings Section Header -->
                        <TextBlock Text="FAN" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- The Legion-tab "Power Profile" dropdown was removed: the Performance tab's
                             TDP Mode dropdown (TDPModeComboBox) is now the single control for the
                             performance mode (Quiet/Balanced/Performance/Custom). The Custom SPL/SPPL/FPPT
                             sliders were likewise moved to the Performance tab. One source of truth. -->

                        <!-- Fan Full Speed Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Fan Full Speed" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock Text="Override fan curve for maximum cooling"
                                               Style="{StaticResource CardCaptionStyle}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="LegionFanFullSpeedToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource ModernToggleStyle}"
                                              IsOn="False"/>
                            </Grid>
                        </Border>

                        <!-- Fan Curve Graph Card -->
                        <Border x:Name="LegionFanCurveCard" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Live fan speed and CPU temperature. The fan follows the firmware curve of the TDP mode (Lenovo's stock curve in Custom). -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Fan" Style="{StaticResource CardTitleStyle}"/>
                                        <StackPanel Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Fan:" FontSize="12" FontWeight="SemiBold" Foreground="#B9C0CC" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="FanRPMLabel" Text="-- RPM" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SystemAccentBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="CPU Temp:" FontSize="12" FontWeight="SemiBold" Foreground="#B9C0CC" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="FanHeaderTempLabel" Text="--°C" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SystemAccentBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                            </StackPanel>
                        </Border>

                        <!-- Driver Updates Card (Lenovo): machine type + installed BIOS +
                             direct link to the correct Lenovo downloads page, with a
                             best-effort live driver list fetched from pcsupport.lenovo.com -->
                        <TextBlock Text="UPDATES" Style="{StaticResource SectionHeaderStyle}"/>
                        <Border x:Name="DriverUpdatesCard" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Lenovo Driver Updates" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Check Lenovo's driver page for this machine type"
                                                   Style="{StaticResource CardCaptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="DriverUpdatesExpandToggle"
                                                  Grid.Column="1"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="DriverUpdatesExpandToggle_Click">
                                        <FontIcon x:Name="DriverUpdatesExpandIcon" Glyph="&#xE70E;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="DriverUpdatesContent" Spacing="10" Margin="0,12,0,0">
                                    <!-- Machine info: two rows of label:value -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Machine type" FontSize="13" Foreground="#B9C0CC"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DriverUpdatesMachineType" Text="—" FontSize="13" Foreground="#FFFFFF"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Model" FontSize="13" Foreground="#B9C0CC" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DriverUpdatesModel" Text="—" FontSize="13" Foreground="#FFFFFF" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Installed BIOS" FontSize="13" Foreground="#B9C0CC" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DriverUpdatesBios" Text="—" FontSize="13" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                                    </Grid>

                                    <!-- Actions row -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="DriverUpdatesCheckButton"
                                                Content="Check for updates"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Click="DriverUpdatesCheckButton_Click"/>
                                        <Button x:Name="DriverUpdatesUpdateAllButton"
                                                Content="Update all"
                                                Visibility="Collapsed"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Click="DriverUpdatesUpdateAllButton_Click"/>
                                        <Button x:Name="DriverUpdatesOpenPageButton"
                                                Content="Open Lenovo driver page"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Click="DriverUpdatesOpenPageButton_Click"/>
                                    </StackPanel>

                                    <TextBlock x:Name="DriverUpdatesStatusText"
                                               Text="Click Check for updates to query Lenovo."
                                               FontSize="11"
                                               Foreground="#B9C0CC"
                                               TextWrapping="Wrap"/>

                                    <Border Height="1" Background="#33FFFFFF" Margin="0,2,0,0"/>

                                    <TextBlock Text="PREFERENCES" FontSize="11" FontWeight="SemiBold" Foreground="#B9C0CC"/>

                                    <!-- Category filter: utilities/diagnostics hidden by default -->
                                    <CheckBox x:Name="DriverUpdatesShowUtilitiesCheckbox"
                                              Content="Show utilities and diagnostics"
                                              IsChecked="False"
                                              FontSize="12"
                                              Foreground="#B9C0CC"
                                              Checked="DriverUpdatesShowUtilitiesCheckbox_Changed"
                                              Unchecked="DriverUpdatesShowUtilitiesCheckbox_Changed"/>

                                    <!-- Auto-install + banner-hide preferences. Persisted in
                                         LocalSettings. UpdateOnStart triggers Update-all the
                                         moment the helper pushes a non-zero driver-update count. -->
                                    <CheckBox x:Name="DriverUpdatesUpdateOnStartCheckbox"
                                              Content="Check for driver updates on start"
                                              IsChecked="True"
                                              FontSize="12"
                                              Foreground="#B9C0CC"
                                              Checked="DriverUpdatesUpdateOnStartCheckbox_Changed"
                                              Unchecked="DriverUpdatesUpdateOnStartCheckbox_Changed"/>
                                    <CheckBox x:Name="DriverUpdatesHideBannerCheckbox"
                                              Content="Hide driver-update banner on Quick tab"
                                              IsChecked="False"
                                              FontSize="12"
                                              Foreground="#B9C0CC"
                                              Checked="DriverUpdatesHideBannerCheckbox_Changed"
                                              Unchecked="DriverUpdatesHideBannerCheckbox_Changed"/>

                                    <!-- Live driver list (populated when the pcsupport API responds) -->
                                    <ItemsControl x:Name="DriverUpdatesList" Visibility="Collapsed">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1A1A2E" CornerRadius="4" Padding="10,8" Margin="0,4,0,0">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                                                            <!-- Status chip: color comes from StatusColor ("#6CCB5F" up-to-date, "#FFB060" update, "#888" unknown/not-installed).
                                                                 Text color comes from StatusTextColor (black on the up-to-date green for contrast, white otherwise). -->
                                                            <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="{Binding StatusTextColor}"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,2,0,0">
                                                            <Run Text="{Binding Category}"/><Run Text=" • "/><Run Text="{Binding Severity}"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="11" Foreground="#B9C0CC" TextWrapping="Wrap" Margin="0,2,0,0">
                                                            <Run Text="Installed:"/><Run Text=" "/><Run Text="{Binding InstalledVersion}"/><Run Text="  →  "/><Run Text="Latest:"/><Run Text=" "/><Run Text="{Binding Version}"/>
                                                        </TextBlock>
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ReleaseDate, FallbackValue=''}" FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1"
                                                                    Content="{Binding InstallButtonLabel}"
                                                                    Tag="{Binding DownloadUrl}"
                                                                    Visibility="{Binding InstallButtonVisibility}"
                                                                    Style="{StaticResource ModernButtonStyle}"
                                                                    FontSize="11"
                                                                    Padding="10,4"
                                                                    Click="DriverInstallButton_Click"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Connection Status Banner - placed last for z-order (renders on top) -->
                <!-- Visible by default with Loading... so user sees immediate feedback before code runs -->
                <Border x:Name="ConnectionStatusBanner"
                        Background="#3366CC"
                        Padding="8,4"
                        VerticalAlignment="Top"
                        Visibility="Visible"
                        CornerRadius="0"
                        Margin="0,0,0,0">
                    <TextBlock x:Name="ConnectionStatusText"
                               Text="Loading..."
                               Foreground="White"
                               FontSize="12"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Update Available Banner - appears below connection banner when update is found -->
                <Border x:Name="UpdateAvailableBanner"
                        Background="#2D7D2D"
                        Padding="8,6"
                        VerticalAlignment="Top"
                        Visibility="Collapsed"
                        CornerRadius="0"
                        Margin="0,24,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UpdateAvailableText"
                                   Text="Update Available: v0.0.0"
                                   Foreground="White"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Grid.Column="0"
                                   Margin="8,0,0,0"/>
                        <Button x:Name="UpdateBannerButton"
                                Content="Update"
                                Grid.Column="1"
                                Padding="12,2"
                                FontSize="11"
                                Background="#3D9D3D"
                                Foreground="White"
                                Margin="8,0,0,0"
                                Click="UpdateBannerButton_Click"/>
                        <Button x:Name="DismissUpdateBannerButton"
                                Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                Grid.Column="2"
                                Padding="6,2"
                                FontSize="10"
                                Background="Transparent"
                                Foreground="#AAFFAA"
                                Margin="4,0,4,0"
                                Click="DismissUpdateBannerButton_Click"/>
                    </Grid>
                </Border>

            </Grid>
            </Grid> <!-- End Content Area Grid.Row="1" -->
        </Grid> <!-- End MainNavContainer -->
    </Grid>
</Page>

                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsOn="False"/>
                                </Grid>

                                <StackPanel x:Name="BrightnessGestureOptionsPanel" Spacing="12" Visibility="Collapsed">
                                    <!-- Trigger Button -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Trigger" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                        <ComboBox x:Name="BrightnessGestureTriggerComboBox"
                                                  Grid.Column="1"
                                                  MinWidth="140"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectionChanged="BrightnessGestureTriggerComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Desktop" Tag="0"/>
                                            <ComboBoxItem Content="Page" Tag="1"/>
                                            <ComboBoxItem Content="Scroll Click" Tag="2"/>
                                            <ComboBoxItem Content="Y1" Tag="3"/>
                                            <ComboBoxItem Content="Y2" Tag="4"/>
                                            <ComboBoxItem Content="Y3" Tag="5"/>
                                            <ComboBoxItem Content="M1" Tag="6"/>
                                            <ComboBoxItem Content="M2" Tag="7"/>
                                            <ComboBoxItem Content="M3" Tag="8"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Axis -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Axis" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                        <ComboBox x:Name="BrightnessGestureAxisComboBox"
                                                  Grid.Column="1"
                                                  MinWidth="140"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectionChanged="BrightnessGestureAxisComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Right Stick" Tag="0"/>
                                            <ComboBoxItem Content="Left Stick" Tag="1"/>
                                            <ComboBoxItem Content="D-Pad (Up/Down)" Tag="2"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>

                                <!-- Info note, collapsed by default to keep the card tidy - explains
                                     why Legion L/R aren't offered as trigger options. -->
                                <muxc:Expander HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Stretch"
                                               IsExpanded="False">
                                    <muxc:Expander.Header>
                                        <TextBlock Text="Why not Legion R + left stick, like SteamOS?" FontSize="12" Foreground="#B9C0CC"/>
                                    </muxc:Expander.Header>
                                    <Border Background="{StaticResource PageBackgroundBrush}" CornerRadius="4" Padding="10">
                                        <TextBlock FontSize="11" Foreground="#B9C0CC" TextWrapping="Wrap"
                                                   Text="This gesture was meant to work exactly like on SteamOS - hold Legion R and tilt the left stick. On Windows, holding Legion L or R for more than about 5 seconds is hardcoded in the controller's own firmware to toggle that grip's connection off and on (a real Legion Space feature) - not something GoTweaks, or any app, can override. None of the trigger options below have this limitation."/>
                                    </Border>
                                </muxc:Expander>
                            </StackPanel>
                        </Border>

                        <!-- Fan Settings Section Header -->
                        <TextBlock Text="Fan Settings" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- The Legion-tab "Power Profile" dropdown was removed: the Performance tab's
                             TDP Mode dropdown (TDPModeComboBox) is now the single control for the
                             performance mode (Quiet/Balanced/Performance/Custom). The Custom SPL/SPPL/FPPT
                             sliders were likewise moved to the Performance tab. One source of truth. -->

                        <!-- Fan Full Speed Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Fan Full Speed" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock Text="Override fan curve for maximum cooling"
                                               Style="{StaticResource CardCaptionStyle}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="LegionFanFullSpeedToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource ModernToggleStyle}"
                                              IsOn="False"/>
                            </Grid>
                        </Border>

                        <!-- Fan Curve Graph Card -->
                        <Border x:Name="LegionFanCurveCard" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Header with expand toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Fan Curve" Style="{StaticResource CardTitleStyle}"/>
                                        <!-- Live hardware readout: fan RPM + the temperature currently
                                             driving the fan. Always shown while the card is expanded,
                                             independent of which mode's curve is selected below. -->
                                        <StackPanel Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Fan:" FontSize="12" FontWeight="SemiBold" Foreground="#B9C0CC" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="FanRPMLabel" Text="-- RPM" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SystemAccentBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="CPU Temp:" FontSize="12" FontWeight="SemiBold" Foreground="#B9C0CC" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="FanHeaderTempLabel" Text="--°C" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SystemAccentBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Spells out that the graph below edits the Custom-mode curve, and
                                             whether the console is currently running it. Set in UpdateActiveModeLabel. -->
                                        <TextBlock x:Name="FanCurveActiveModeLabel"
                                                   FontSize="10" Foreground="#88B0E0" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="FanCurveExpandToggle"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="FanCurveExpandToggle_Click">
                                        <FontIcon x:Name="FanCurveExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>

                                <Border Height="1" Background="#33FFFFFF" Margin="0,10,0,0"/>

                                <!-- Info / warning collapsed by default to keep the card tidy. Contains
                                     the safety warning and a short behavioral explainer. -->
                                <muxc:Expander x:Name="FanCurveInfoExpander"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Stretch"
                                               IsExpanded="False">
                                    <muxc:Expander.Header>
                                        <TextBlock Text="Info &amp; safety notes" FontSize="12" Foreground="#B9C0CC"/>
                                    </muxc:Expander.Header>
                                    <StackPanel>
                                        <Border Background="#3D2A1A" CornerRadius="4" Padding="10"
                                                x:Name="FanCurveWarningBorder">
                                            <StackPanel>
                                                <TextBlock Foreground="#FFB060" FontWeight="SemiBold" FontSize="12">
                                                    ⚠ Aggressive curves can damage hardware
                                                </TextBlock>
                                                <TextBlock Foreground="#DDB890" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Text="• Never 0% above ~50°C"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{StaticResource PageBackgroundBrush}" CornerRadius="4" Padding="10" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock FontSize="11" Foreground="#888888" TextWrapping="Wrap"
                                                           Text="• This curve is applied through Lenovo WMI while TDP Mode is Custom, with firmware-enforced floors&#x0a;• Quiet, Balanced and Performance use the firmware's own fan curves&#x0a;• Axis labels (10°C–100°C) are how the curve is stored; firmware may map temps differently"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </muxc:Expander>

                                <!-- Expandable graph content -->
                                <StackPanel x:Name="FanCurveContent" Margin="0,12,0,0" Visibility="Collapsed">
                                    <!-- Y-axis label -->
                                    <TextBlock Text="Fan %" FontSize="11" Foreground="#888888" Margin="0,0,0,4"/>

                                    <!-- Graph area -->
                                    <Grid Height="150">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Y-axis labels (percentage scale) -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Stretch">
                                            <TextBlock Text="100" FontSize="10" Foreground="#888888" VerticalAlignment="Top"/>
                                            <TextBlock Text="75" FontSize="10" Foreground="#888888" VerticalAlignment="Top" Margin="0,25,0,0"/>
                                            <TextBlock Text="50" FontSize="10" Foreground="#888888" VerticalAlignment="Top" Margin="0,25,0,0"/>
                                            <TextBlock Text="25" FontSize="10" Foreground="#888888" VerticalAlignment="Top" Margin="0,25,0,0"/>
                                            <TextBlock Text="0" FontSize="10" Foreground="#888888" VerticalAlignment="Bottom"/>
                                        </StackPanel>

                                        <!-- Canvas for drawing the graph -->
                                        <Canvas x:Name="FanCurveCanvas"
                                                Grid.Column="1"
                                                Background="#1A1A1A"
                                                PointerPressed="FanCurveCanvas_PointerPressed"
                                                PointerMoved="FanCurveCanvas_PointerMoved"
                                                PointerReleased="FanCurveCanvas_PointerReleased"
                                                PointerCaptureLost="FanCurveCanvas_PointerReleased"
                                                SizeChanged="FanCurveCanvas_SizeChanged">
                                            <!-- Grid lines drawn in code-behind -->

                                            <!-- Fill under the curve -->
                                            <Polygon x:Name="FanCurveFill"
                                                     Fill="#3300AAFF"
                                                     Stroke="Transparent"/>

                                            <!-- Firmware protection-floor line (dashed orange reference line) -->
                                            <Polyline x:Name="ECFloorPolyline"
                                                      Stroke="#FF6600"
                                                      StrokeThickness="1.5"
                                                      StrokeDashArray="4,2"
                                                      Opacity="0.7"/>

                                            <!-- The curve line -->
                                            <Polyline x:Name="FanCurvePolyline"
                                                      Stroke="#00AAFF"
                                                      StrokeThickness="2"
                                                      StrokeLineJoin="Round"/>

                                            <!-- Temperature indicator line (vertical dashed line) - on top of curve -->
                                            <Line x:Name="TempIndicatorLine"
                                                  Y1="0" Y2="150"
                                                  Stroke="#FF8800"
                                                  StrokeThickness="2"
                                                  StrokeDashArray="4,2"
                                                  Visibility="Collapsed"/>

                                            <!-- RPM indicator line (horizontal dashed line) - on top of curve -->
                                            <Line x:Name="RPMIndicatorLine"
                                                  X1="0" X2="300"
                                                  Stroke="#00FF88"
                                                  StrokeThickness="2"
                                                  StrokeDashArray="4,2"
                                                  Visibility="Collapsed"/>

                                            <!-- Control points are created in code-behind -->
                                        </Canvas>
                                    </Grid>

                                    <!-- X-axis labels — one per curve breakpoint. The breakpoints are
                                         how the curve is stored regardless of how it is applied.
                                         Under the firmware path Lenovo's mapping from
                                         sensor temp to curve point may not be 1:1 with these
                                         labels — the Info expander notes that — but hiding the
                                         labels entirely was worse: users had no temp reference
                                         at all when editing a non-EC-override curve. -->
                                    <Grid x:Name="FanCurveTempAxisGrid" Margin="30,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="10°C" FontSize="9"  Foreground="#888888" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="20"   FontSize="9"  Foreground="#888888" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="2" Text="30"   FontSize="9"  Foreground="#888888" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="3" Text="40"   FontSize="9"  Foreground="#888888" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="4" Text="50"   FontSize="9"  Foreground="#888888" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="5" Text="60"   FontSize="9"  Foreground="#888888" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="6" Text="70"   FontSize="9"  Foreground="#888888" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="7" Text="80"   FontSize="9"  Foreground="#888888" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="8" Text="90"   FontSize="9"  Foreground="#888888" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="8" Text="100°C" FontSize="9" Foreground="#888888" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Legacy locked-state hint, retained as collapsed shim so
                                         the code-behind reference (FanCurveLockedAxisHint) still
                                         resolves. The temp axis grid is now always visible. -->
                                    <TextBlock x:Name="FanCurveLockedAxisHint"
                                               Visibility="Collapsed"
                                               FontSize="9" Foreground="#888888"
                                               HorizontalAlignment="Center"/>

                                    <!-- Current temperature display (true CPU temperature). -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                                        <TextBlock x:Name="CurrentTempPrefixLabel" Text="CPU Temp: " FontSize="12" Foreground="#888888"/>
                                        <TextBlock x:Name="CurrentTempLabel" Text="--°C" FontSize="12" Foreground="#FF8800" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <!-- Firmware protection-floor legend; shown while the viewed curve is the one
                                         actually running (see RefreshFanCurveGraphForUnlockState). -->
                                    <StackPanel x:Name="ECFloorLegendPanel" Orientation="Horizontal" Margin="0,4,0,0" HorizontalAlignment="Center">
                                        <Line X1="0" Y1="0" X2="20" Y2="0" Stroke="#FF8800" StrokeThickness="2" StrokeDashArray="4,2" VerticalAlignment="Center"/>
                                        <TextBlock Text=" EC Protection Floor" FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Battery Section Header -->
                        <TextBlock Text="Battery" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Battery Charge Limit Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Charge Limit (80%)" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock Text="Limit battery charge to extend lifespan"
                                               Style="{StaticResource CardCaptionStyle}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="LegionChargeLimitToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource ModernToggleStyle}"
                                              IsOn="False"/>
                            </Grid>
                        </Border>

                        <!-- LABS Section Header -->
                        <TextBlock Text="Labs" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Labs Description -->
                        <TextBlock Text="Experimental fixes for specific hardware quirks. Safe to leave off — only turn one on if you actually recognize the problem it describes."
                                   Style="{StaticResource CardCaptionStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,8"/>

                        <!-- Disable Legion Space Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Disable Legion Space Service" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Stops Lenovo's Legion Space background service so GoTweaks has exclusive control of the controllers' Legion L/R buttons. Only needed if Legion Space is fighting GoTweaks over TDP, button remaps, or the fan curve — you can still open Legion Space itself normally, e.g. for firmware updates."
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="ToggleDAServiceButton"
                                            Grid.Column="1"
                                            Content="Disable"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Click="ToggleDAServiceButton_Click"/>
                                </Grid>
                                <Border Height="1" Background="#33FFFFFF" Margin="0,12,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Status:" FontSize="12" Foreground="#B9C0CC" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="DAServiceStatusText"
                                               Text="Checking..."
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Fix Task View Bug Card (optional USB phantom-input fix) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Fix Task View Bug" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Fixes a rare USB quirk on some setups: with a hub attached at boot, Task View starts popping open on its own (with a controller buzz) every time you return to the desktop, until a controller is unplugged and replugged. Turning this on re-cycles the controller's USB connection once automatically after every restart, so you never have to do it by hand."
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="ToggleTaskViewFixButton"
                                            Grid.Column="1"
                                            Content="Enable"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Click="ToggleTaskViewFixButton_Click"/>
                                </Grid>
                                <Border Height="1" Background="#33FFFFFF" Margin="0,12,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Status:" FontSize="12" Foreground="#B9C0CC" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="TaskViewFixStatusText"
                                               Text="Checking..."
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"/>
                                </StackPanel>
                                <Button x:Name="TaskViewFixRunNowButton"
                                        Content="Run fix now (one-time)"
                                        Margin="0,10,0,0"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Click="TaskViewFixRunNowButton_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Driver Updates Card (Lenovo): machine type + installed BIOS +
                             direct link to the correct Lenovo downloads page, with a
                             best-effort live driver list fetched from pcsupport.lenovo.com -->
                        <TextBlock Text="Driver Updates" Style="{StaticResource SectionHeaderStyle}"/>
                        <Border x:Name="DriverUpdatesCard" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Lenovo Driver Updates" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Check Lenovo's driver page for this machine type"
                                                   Style="{StaticResource CardCaptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="DriverUpdatesExpandToggle"
                                                  Grid.Column="1"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="DriverUpdatesExpandToggle_Click">
                                        <FontIcon x:Name="DriverUpdatesExpandIcon" Glyph="&#xE70E;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="DriverUpdatesContent" Spacing="10" Margin="0,12,0,0">
                                    <!-- Machine info: two rows of label:value -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Machine type" FontSize="13" Foreground="#B9C0CC"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DriverUpdatesMachineType" Text="—" FontSize="13" Foreground="#FFFFFF"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Model" FontSize="13" Foreground="#B9C0CC" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DriverUpdatesModel" Text="—" FontSize="13" Foreground="#FFFFFF" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Installed BIOS" FontSize="13" Foreground="#B9C0CC" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DriverUpdatesBios" Text="—" FontSize="13" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                                    </Grid>

                                    <!-- Actions row -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="DriverUpdatesCheckButton"
                                                Content="Check for updates"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Click="DriverUpdatesCheckButton_Click"/>
                                        <Button x:Name="DriverUpdatesUpdateAllButton"
                                                Content="Update all"
                                                Visibility="Collapsed"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Click="DriverUpdatesUpdateAllButton_Click"/>
                                        <Button x:Name="DriverUpdatesOpenPageButton"
                                                Content="Open Lenovo driver page"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Click="DriverUpdatesOpenPageButton_Click"/>
                                    </StackPanel>

                                    <TextBlock x:Name="DriverUpdatesStatusText"
                                               Text="Click Check for updates to query Lenovo."
                                               FontSize="11"
                                               Foreground="#B9C0CC"
                                               TextWrapping="Wrap"/>

                                    <Border Height="1" Background="#33FFFFFF" Margin="0,2,0,0"/>

                                    <TextBlock Text="PREFERENCES" FontSize="11" FontWeight="SemiBold" Foreground="#B9C0CC"/>

                                    <!-- Category filter: utilities/diagnostics hidden by default -->
                                    <CheckBox x:Name="DriverUpdatesShowUtilitiesCheckbox"
                                              Content="Show utilities and diagnostics"
                                              IsChecked="False"
                                              FontSize="12"
                                              Foreground="#B9C0CC"
                                              Checked="DriverUpdatesShowUtilitiesCheckbox_Changed"
                                              Unchecked="DriverUpdatesShowUtilitiesCheckbox_Changed"/>

                                    <!-- Auto-install + banner-hide preferences. Persisted in
                                         LocalSettings. UpdateOnStart triggers Update-all the
                                         moment the helper pushes a non-zero driver-update count. -->
                                    <CheckBox x:Name="DriverUpdatesUpdateOnStartCheckbox"
                                              Content="Check for driver updates on start"
                                              IsChecked="True"
                                              FontSize="12"
                                              Foreground="#B9C0CC"
                                              Checked="DriverUpdatesUpdateOnStartCheckbox_Changed"
                                              Unchecked="DriverUpdatesUpdateOnStartCheckbox_Changed"/>
                                    <CheckBox x:Name="DriverUpdatesHideBannerCheckbox"
                                              Content="Hide driver-update banner on Quick tab"
                                              IsChecked="False"
                                              FontSize="12"
                                              Foreground="#B9C0CC"
                                              Checked="DriverUpdatesHideBannerCheckbox_Changed"
                                              Unchecked="DriverUpdatesHideBannerCheckbox_Changed"/>

                                    <!-- Live driver list (populated when the pcsupport API responds) -->
                                    <ItemsControl x:Name="DriverUpdatesList" Visibility="Collapsed">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1A1A2E" CornerRadius="4" Padding="10,8" Margin="0,4,0,0">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                                                            <!-- Status chip: color comes from StatusColor ("#6CCB5F" up-to-date, "#FFB060" update, "#888" unknown/not-installed).
                                                                 Text color comes from StatusTextColor (black on the up-to-date green for contrast, white otherwise). -->
                                                            <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="{Binding StatusTextColor}"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,2,0,0">
                                                            <Run Text="{Binding Category}"/><Run Text=" • "/><Run Text="{Binding Severity}"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="11" Foreground="#B9C0CC" TextWrapping="Wrap" Margin="0,2,0,0">
                                                            <Run Text="Installed:"/><Run Text=" "/><Run Text="{Binding InstalledVersion}"/><Run Text="  →  "/><Run Text="Latest:"/><Run Text=" "/><Run Text="{Binding Version}"/>
                                                        </TextBlock>
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ReleaseDate, FallbackValue=''}" FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1"
                                                                    Content="{Binding InstallButtonLabel}"
                                                                    Tag="{Binding DownloadUrl}"
                                                                    Visibility="{Binding InstallButtonVisibility}"
                                                                    Style="{StaticResource ModernButtonStyle}"
                                                                    FontSize="11"
                                                                    Padding="10,4"

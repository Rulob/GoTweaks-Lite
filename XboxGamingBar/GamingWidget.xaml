                        <!-- Power & Sleep Card (Collapsible): power button behavior + screen/hibernate
                             idle timers, merged under one expandable card matching Windows' own
                             "Power & sleep" settings grouping. Power Button + Display Timeout are
                             pulled directly from the active Windows power plan; Hibernate Timeout is
                             a GoTweaks-only feature (see its section note below). -->
                        <Border x:Name="PowerAndSleepCard" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Power &amp; Sleep" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Power button behavior and idle timers"
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="PowerAndSleepExpandButton"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="PowerAndSleepExpandButton_Click">
                                        <FontIcon x:Name="PowerAndSleepExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>

                                <StackPanel x:Name="PowerAndSleepContent" Visibility="Collapsed" Margin="0,12,0,0">

                                    <TextBlock Text="Power button" FontSize="13" FontWeight="SemiBold" Foreground="#B9C0CC"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Plugged in (AC)" FontSize="13" Foreground="White" VerticalAlignment="Center" Grid.Column="0"/>
                                        <ComboBox x:Name="PowerButtonActionACComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem Content="Sleep" Tag="1"/>
                                            <ComboBoxItem Content="Hibernate" Tag="2"/>
                                            <ComboBoxItem Content="Do nothing" Tag="0"/>
                                            <ComboBoxItem Content="Shut down" Tag="3"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="On battery (DC)" FontSize="13" Foreground="White" VerticalAlignment="Center" Grid.Column="0"/>
                                        <ComboBox x:Name="PowerButtonActionDCComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem Content="Sleep" Tag="1"/>
                                            <ComboBoxItem Content="Hibernate" Tag="2"/>
                                            <ComboBoxItem Content="Do nothing" Tag="0"/>
                                            <ComboBoxItem Content="Shut down" Tag="3"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Margin="0,14,0,0" Height="1" Background="#22FFFFFF"/>

                                    <TextBlock Text="Turn off screen after" FontSize="13" FontWeight="SemiBold" Foreground="#B9C0CC" Margin="0,12,0,0"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Plugged in (AC)" FontSize="13" Foreground="White" VerticalAlignment="Center" Grid.Column="0"/>
                                        <ComboBox x:Name="DisplayTimeoutACComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem Content="Never" Tag="0"/>
                                            <ComboBoxItem Content="1 minute" Tag="60"/>
                                            <ComboBoxItem Content="2 minutes" Tag="120"/>
                                            <ComboBoxItem Content="3 minutes" Tag="180"/>
                                            <ComboBoxItem Content="5 minutes" Tag="300"/>
                                            <ComboBoxItem Content="10 minutes" Tag="600"/>
                                            <ComboBoxItem Content="15 minutes" Tag="900"/>
                                            <ComboBoxItem Content="20 minutes" Tag="1200"/>
                                            <ComboBoxItem Content="30 minutes" Tag="1800"/>
                                            <ComboBoxItem Content="45 minutes" Tag="2700"/>
                                            <ComboBoxItem Content="1 hour" Tag="3600"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="On battery (DC)" FontSize="13" Foreground="White" VerticalAlignment="Center" Grid.Column="0"/>
                                        <ComboBox x:Name="DisplayTimeoutDCComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem Content="Never" Tag="0"/>
                                            <ComboBoxItem Content="1 minute" Tag="60"/>
                                            <ComboBoxItem Content="2 minutes" Tag="120"/>
                                            <ComboBoxItem Content="3 minutes" Tag="180"/>
                                            <ComboBoxItem Content="5 minutes" Tag="300"/>
                                            <ComboBoxItem Content="10 minutes" Tag="600"/>
                                            <ComboBoxItem Content="15 minutes" Tag="900"/>
                                            <ComboBoxItem Content="20 minutes" Tag="1200"/>
                                            <ComboBoxItem Content="30 minutes" Tag="1800"/>
                                            <ComboBoxItem Content="45 minutes" Tag="2700"/>
                                            <ComboBoxItem Content="1 hour" Tag="3600"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Margin="0,14,0,0" Height="1" Background="#22FFFFFF"/>

                                    <TextBlock Text="Hibernate after" FontSize="13" FontWeight="SemiBold" Foreground="#B9C0CC" Margin="0,12,0,0"/>
                                    <TextBlock Text="GoTweaks feature - not a Windows setting, since Windows has no built-in idle-to-hibernate timer"
                                               FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Plugged in (AC)" FontSize="13" Foreground="White" VerticalAlignment="Center" Grid.Column="0"/>
                                        <ComboBox x:Name="HibernateTimeoutACComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem Content="Never" Tag="0"/>
                                            <ComboBoxItem Content="10 minutes" Tag="10"/>
                                            <ComboBoxItem Content="15 minutes" Tag="15"/>
                                            <ComboBoxItem Content="20 minutes" Tag="20"/>
                                            <ComboBoxItem Content="30 minutes" Tag="30"/>
                                            <ComboBoxItem Content="45 minutes" Tag="45"/>
                                            <ComboBoxItem Content="1 hour" Tag="60"/>
                                            <ComboBoxItem Content="2 hours" Tag="120"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="On battery (DC)" FontSize="13" Foreground="White" VerticalAlignment="Center" Grid.Column="0"/>
                                        <ComboBox x:Name="HibernateTimeoutDCComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem Content="Never" Tag="0"/>
                                            <ComboBoxItem Content="10 minutes" Tag="10"/>
                                            <ComboBoxItem Content="15 minutes" Tag="15"/>
                                            <ComboBoxItem Content="20 minutes" Tag="20"/>
                                            <ComboBoxItem Content="30 minutes" Tag="30"/>
                                            <ComboBoxItem Content="45 minutes" Tag="45"/>
                                            <ComboBoxItem Content="1 hour" Tag="60"/>
                                            <ComboBoxItem Content="2 hours" Tag="120"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Windows' own Sleep idle timer (Settings > Power & battery)
                                         still runs independently of the Hibernate timer above and can
                                         fire first, sending the system to Sleep before our Hibernate
                                         timeout is ever reached. This one-off button zeroes Windows'
                                         Sleep-after timeout for both AC and DC so the GoTweaks
                                         Hibernate timer above is the only idle-power action left. -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Windows' own Sleep timer can still fire first"
                                                       FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="DisableSleepTimersStatusText"
                                                       Text=""
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#6CCB5F"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="DisableSleepTimersButton"
                                                Grid.Column="1"
                                                Content="Disable Sleep Timer (AC+DC)"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Click="DisableSleepTimersButton_Click"
                                                VerticalAlignment="Center"/>
                                    </Grid>

                                    <muxc:Expander x:Name="PowerButtonInfoExpander"
                                                   Margin="0,14,0,0"
                                                   HorizontalAlignment="Stretch"
                                                   HorizontalContentAlignment="Stretch"
                                                   IsExpanded="False">
                                        <muxc:Expander.Header>
                                            <TextBlock Text="Recommendation" FontSize="12" Foreground="#B9C0CC"/>
                                        </muxc:Expander.Header>
                                        <Border Background="#3D2A1A" CornerRadius="4" Padding="10">
                                            <StackPanel>
                                                <TextBlock Foreground="#FFB060" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"
                                                           Text="⚠ Use Hibernate instead of Sleep"/>
                                                <TextBlock Foreground="#DDB890" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Text="Windows' default Sleep (Modern Standby) sometimes drains the battery from background wake-ups or fails to resume cleanly. Hibernate saves the session to disk and fully powers off, which is closer to how SteamOS suspends and tends to be more reliable - at the cost of a slightly slower resume. Setting the Power Button and Hibernate Timeout options above to Hibernate (and disabling Windows' Sleep timer) is the recommended change."/>
                                            </StackPanel>
                                        </Border>
                                    </muxc:Expander>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Debug Card (Collapsible) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Header with Expand/Collapse -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Debug" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Troubleshooting and diagnostic tools"
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="DebugExpandButton"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="DebugExpandButton_Click">
                                        <FontIcon x:Name="DebugExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>

                                <!-- Collapsible Content -->
                                <StackPanel x:Name="DebugContent" Visibility="Collapsed" Margin="0,12,0,0">
                                    <!-- Restart Helper / Kill GoTweaks Buttons (side by side) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="RestartHelperButton"
                                                Grid.Column="0"
                                                Content="Restart Helper"
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource StandaloneButtonStyle}"
                                                Click="RestartHelperButton_Click"/>
                                        <Button x:Name="KillGoTweaksButton"
                                                Grid.Column="2"
                                                Content="Kill GoTweaks Lite"
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource StandaloneButtonStyle}"
                                                Click="KillGoTweaksButton_Click"/>
                                    </Grid>

                                    <!-- Export Logs Button -->
                                    <Button x:Name="ExportLogsButton"
                                            Content="Export Logs"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,8,0,0"
                                            Style="{StaticResource StandaloneButtonStyle}"
                                            Click="ExportLogsButton_Click"/>

                                    <!-- Export/Import All Data Buttons (side by side) -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ExportAllDataButton"
                                                Grid.Column="0"
                                                Content="Export All Data"
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource StandaloneButtonStyle}"
                                                Click="ExportAllDataButton_Click"/>
                                        <Button x:Name="ImportAllDataButton"
                                                Grid.Column="2"
                                                Content="Import All Data"
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource StandaloneButtonStyle}"
                                                Click="ImportAllDataButton_Click"/>
                                    </Grid>

                                    <!-- Prepare for Uninstall Button -->
                                    <Button x:Name="PrepareForUninstallButton"
                                            Content="Prepare for Uninstall"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,8,0,0"
                                            Style="{StaticResource StandaloneButtonStyle}"
                                            Click="PrepareForUninstallButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- About Card (Collapsible) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Header with Expand/Collapse -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="About" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Version and credits"
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="AboutExpandButton"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="AboutExpandButton_Click">
                                        <FontIcon x:Name="AboutExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>

                                <!-- Collapsible Content -->
                                <StackPanel x:Name="AboutContent" Visibility="Collapsed" Margin="0,12,0,0">
                                    <!-- Updates - everything update-related lives here, at the top. -->
                                    <Button x:Name="CheckForUpdateButton"
                                            Content="Check for Update"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource StandaloneButtonStyle}"
                                            Click="CheckForUpdateButton_Click"/>

                                    <!-- Update Status Text -->
                                    <TextBlock x:Name="UpdateStatusText"
                                               Text=""
                                               FontSize="12"
                                               Foreground="#B9C0CC"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"
                                               Visibility="Collapsed"/>

                                    <!-- Update Button (shown when update available) -->
                                    <Button x:Name="UpdateButton"
                                            Content="Update"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,8,0,0"
                                            Style="{StaticResource StandaloneButtonStyle}"
                                            Background="#107C10"
                                            Click="UpdateButton_Click"
                                            Visibility="Collapsed"/>

                                    <!-- Single "check for updates automatically" preference, gating both
                                         update surfaces (the helper's Quick-tab banner probe and the
                                         widget's own startup auto-check) so there is only one on-screen
                                         toggle instead of two near-duplicate ones. -->
                                    <Grid Margin="0,20,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Check for updates automatically on start"
                                                   FontSize="12"
                                                   Foreground="#B9C0CC"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <ToggleSwitch x:Name="GoTweaksUpdateOnStartCheckbox"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsOn="True"
                                                      Toggled="GoTweaksUpdateOnStartCheckbox_Changed"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Hide GoTweaks Lite update banner on Quick tab"
                                                   FontSize="12"
                                                   Foreground="#B9C0CC"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <ToggleSwitch x:Name="GoTweaksHideBannerCheckbox"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsOn="False"
                                                      Toggled="GoTweaksHideBannerCheckbox_Changed"/>
                                    </Grid>

                                    <Border Height="1" Background="#33FFFFFF" Margin="0,16,0,16"/>

                                    <!-- Version -->
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Version"
                                                   FontSize="13"
                                                   Foreground="#B9C0CC"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AboutVersionText"
                                                   Text="0.3.98.0"
                                                   FontSize="14"
                                                   Foreground="#6CCB5F"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Fork Author -->
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Fork Author"
                                                   FontSize="13"
                                                   Foreground="#B9C0CC"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="RuloB"
                                                   FontSize="14"
                                                   Foreground="{StaticResource SystemAccentBrush}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Original Author -->
                                    <Grid Margin="0,0,0,0">
                                        <TextBlock Text="Original Author"
                                                   FontSize="13"
                                                   Foreground="#B9C0CC"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="LtChipotle"
                                                   FontSize="14"
                                                   Foreground="#FFFFFF"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- SCALING TAB -->
                <ScrollViewer x:Name="ScalingScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,8,16,16">

                        <!-- Status Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Lossless Scaling Status" Style="{StaticResource CardTitleStyle}" Grid.Column="0" VerticalAlignment="Center"/>
                                    <Button x:Name="ShowLosslessScalingWindowButton"
                                            Grid.Column="1"
                                            Content="Show Window"
                                            Margin="0,0,8,0"
                                            Visibility="Collapsed"
                                            Click="ShowLosslessScalingWindowButton_Click"
                                            XYFocusUp="{x:Bind ScalingNavItem}"/>
                                    <Button x:Name="LaunchLosslessScalingButton"
                                            Grid.Column="2"
                                            Content="Launch"
                                            Visibility="Collapsed"
                                            Click="LaunchLosslessScalingButton_Click"
                                            XYFocusUp="{x:Bind ScalingNavItem}"/>
                                </Grid>
                                <TextBlock x:Name="LosslessScalingStatusText"
                                           Text="Not Installed"
                                           Style="{StaticResource CardCaptionStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- Current Profile Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Current Profile" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock x:Name="LosslessScalingCurrentProfileText"
                                                   Text="Default"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource SystemAccentBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="LosslessScalingCreateProfileButton"
                                            Grid.Column="1"
                                            Content="Create Profile"
                                            VerticalAlignment="Center"
                                            IsEnabled="False"
                                            Click="LosslessScalingCreateProfileButton_Click"
                                            XYFocusUp="{x:Bind ScalingNavItem}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Scale Toggle Button -->
                        <ToggleButton x:Name="LosslessScalingEnabledToggle"
                                      Content="Scale"
                                      HorizontalAlignment="Stretch"
                                      IsEnabled="False"
                                      FontSize="16"
                                      FontWeight="SemiBold"
                                      Margin="0,10,0,0"
                                      Style="{StaticResource ScaleToggleButtonStyle}"/>

                        <!-- Apply and Restart Button -->
                        <Button x:Name="LosslessScalingSaveSettingsButton"
                                Content="Apply and Restart"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"
                                IsEnabled="False"
                                Style="{StaticResource LosslessScalingApplyButtonStyle}"
                                Click="LosslessScalingSaveSettingsButton_Click"/>

                        <!-- Reset Profile Button -->
                        <Button x:Name="LosslessScalingResetProfileButton"
                                Content="Reset to Defaults"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"
                                IsEnabled="False"
                                Style="{StaticResource StandaloneButtonStyle}"
                                Click="LosslessScalingResetProfileButton_Click"/>

                        <!-- AutoScale Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="AutoScale" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Automatically detect and scale games"
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LosslessScalingAutoScaleToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False"/>
                                </Grid>
                                <StackPanel Visibility="{Binding ElementName=LosslessScalingAutoScaleToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="AutoScale Delay (s)"
                                                   FontSize="13"
                                                   Foreground="#B9C0CC"/>
                                        <TextBlock x:Name="LosslessScalingAutoScaleDelayValueText"
                                                   Text="{Binding ElementName=LosslessScalingAutoScaleDelaySlider, Path=Value}"
                                                   FontSize="13"
                                                   Foreground="#B9C0CC"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="LosslessScalingAutoScaleDelaySlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="0" Maximum="10"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            TickPlacement="BottomRight"
                                            IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Scaling Type Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Scaling Algorithm" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="LosslessScalingScalingTypeComboBox"
                                          PlaceholderText="Select Type"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="False"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectionChanged="LosslessScalingScalingTypeComboBox_SelectionChanged">
                                    <x:String>Off</x:String>
                                    <x:String>LS1</x:String>
                                    <x:String>FSR</x:String>
                                    <x:String>NIS</x:String>
                                    <x:String>SGSR</x:String>
                                    <x:String>BCAS</x:String>
                                    <x:String>Anime4K</x:String>
                                    <x:String>xBR</x:String>
                                    <x:String>Sharp Bilinear</x:String>
                                    <x:String>Integer</x:String>
                                    <x:String>Nearest Neighbor</x:String>
                                </ComboBox>

                                <!-- Sharpness Slider (for FSR, NIS, SGSR, BCAS) -->
                                <StackPanel x:Name="LosslessScalingSharpnessPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <Grid>
                                        <TextBlock Text="Sharpness" FontSize="13" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="LosslessScalingSharpnessValueText"
                                                   Text="{Binding ElementName=LosslessScalingSharpnessSlider, Path=Value}"
                                                   FontSize="13"
                                                   Foreground="#B9C0CC"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="LosslessScalingSharpnessSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="0" Maximum="100"
                                            TickFrequency="10"
                                            SnapsTo="Ticks"
                                            TickPlacement="BottomRight"
                                            IsEnabled="False"/>
                                </StackPanel>

                                <!-- FSR Optimize Toggle (FSR only) -->
                                <Grid x:Name="LosslessScalingFSROptimizePanel" Visibility="Collapsed" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Optimize" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="LosslessScalingFSROptimizeToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False"/>
                                </Grid>

                                <!-- LS1 Type (LS1 only) — BALANCED vs PERFORMANCE -->
                                <StackPanel x:Name="LosslessScalingLS1TypePanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <TextBlock Text="LS1 Type" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="LosslessScalingLS1TypeComboBox"
                                              PlaceholderText="Select Type"
                                              Width="Auto"
                                              HorizontalAlignment="Stretch"
                                              IsEnabled="False"
                                              Style="{StaticResource ModernComboBoxStyle}">
                                        <x:String>BALANCED</x:String>
                                        <x:String>PERFORMANCE</x:String>
                                    </ComboBox>
                                </StackPanel>

                                <!-- LS1 Sharpness (LS1 only) - LS1's own dedicated sharpness field
                                     (Settings.xml "LS1Sharpness"), separate from the general
                                     Sharpness field above used by FSR/NIS/SGSR/BCAS. -->
                                <StackPanel x:Name="LosslessScalingLS1SharpnessPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <Grid>
                                        <TextBlock Text="Sharpness" FontSize="13" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="LosslessScalingLS1SharpnessValueText"
                                                   Text="{Binding ElementName=LosslessScalingLS1SharpnessSlider, Path=Value}"
                                                   FontSize="13"
                                                   Foreground="#B9C0CC"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="LosslessScalingLS1SharpnessSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="0" Maximum="10"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            TickPlacement="BottomRight"
                                            IsEnabled="False"/>
                                </StackPanel>

                                <!-- Resize Before Scale (any non-Off scaling type) -->
                                <Grid x:Name="LosslessScalingResizeBeforePanel" Visibility="Collapsed" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Resize Before Scale" FontSize="13" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Snap window to integer ratio before upscale"
                                                   FontSize="11" Foreground="#888888"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LosslessScalingResizeBeforeToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False"/>
                                </Grid>

                                <!-- Anime4K Settings -->
                                <StackPanel x:Name="LosslessScalingAnime4KPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <TextBlock Text="Size" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="LosslessScalingAnime4KSizeComboBox"
                                              PlaceholderText="Select Size"
                                              Width="Auto"
                                              HorizontalAlignment="Stretch"
                                              IsEnabled="False"
                                              Style="{StaticResource ModernComboBoxStyle}">
                                        <x:String>Small</x:String>
                                        <x:String>Medium</x:String>
                                        <x:String>Large</x:String>
                                        <x:String>Very Large</x:String>
                                        <x:String>Ultra Large</x:String>
                                    </ComboBox>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="VRS" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="LosslessScalingAnime4KVRSToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsEnabled="False"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Scale Mode Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Scale Mode" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="LosslessScalingScaleModeComboBox"
                                          PlaceholderText="Select Mode"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="False"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectionChanged="LosslessScalingScaleModeComboBox_SelectionChanged">
                                    <x:String>Auto</x:String>
                                    <x:String>Custom</x:String>
                                </ComboBox>

                                <!-- Auto Mode Settings -->
                                <StackPanel x:Name="LosslessScalingAutoModePanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <TextBlock Text="Aspect" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="LosslessScalingAspectRatioComboBox"
                                              PlaceholderText="Select Aspect"
                                              Width="Auto"
                                              HorizontalAlignment="Stretch"
                                              IsEnabled="False"
                                              Style="{StaticResource ModernComboBoxStyle}">
                                        <x:String>Aspect Ratio</x:String>
                                        <x:String>Fullscreen</x:String>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Custom Mode Settings -->
                                <StackPanel x:Name="LosslessScalingCustomModePanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <Grid>
                                        <TextBlock Text="Scale Factor" FontSize="13" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="LosslessScalingScaleFactorValueText"
                                                   Text="{Binding ElementName=LosslessScalingScaleFactorSlider, Path=Value}"
                                                   FontSize="13"
                                                   Foreground="#B9C0CC"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="LosslessScalingScaleFactorSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="1" Maximum="5"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            TickPlacement="BottomRight"
                                            IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Frame Generation Type Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Frame Generation" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="LosslessScalingFrameGenTypeComboBox"
                                          PlaceholderText="Select Type"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="False"
                                          Style="{StaticResource ModernComboBoxStyle}">
                                    <x:String>Off</x:String>
                                    <x:String>LSFG1</x:String>
                                    <x:String>LSFG2</x:String>
                                    <x:String>LSFG3</x:String>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- LSFG3 Settings Card -->
                        <Border x:Name="LSFG3SettingsCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="LSFG3 Settings" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>

                                <!-- LSFG3 Mode -->
                                <TextBlock Text="Mode" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <ComboBox x:Name="LosslessScalingLSFG3ModeComboBox"
                                          PlaceholderText="Select Mode"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="False"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          Margin="0,0,0,12"
                                          SelectionChanged="LosslessScalingLSFG3ModeComboBox_SelectionChanged">
                                    <x:String>FIXED</x:String>
                                    <x:String>ADAPTIVE</x:String>
                                </ComboBox>

                                <!-- LSFG3 Multiplier (hidden when Adaptive) -->
                                <StackPanel x:Name="LosslessScalingLSFG3MultiplierPanel">
                                    <TextBlock Text="Multiplier" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="LosslessScalingLSFG3MultiplierComboBox"
                                              PlaceholderText="Select Multiplier"
                                              Width="Auto"
                                              HorizontalAlignment="Stretch"
                                              IsEnabled="False"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              Margin="0,0,0,12">
                                        <x:String>2</x:String>
                                        <x:String>3</x:String>
                                        <x:String>4</x:String>
                                    </ComboBox>
                                </StackPanel>

                                <!-- LSFG3 Target FPS -->
                                <Grid>
                                    <TextBlock Text="Target FPS" FontSize="13" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="LosslessScalingLSFG3TargetValueText"
                                               Text="{Binding ElementName=LosslessScalingLSFG3TargetSlider, Path=Value}"
                                               FontSize="13"
                                               Foreground="#B9C0CC"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="LosslessScalingLSFG3TargetSlider"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Minimum="30" Maximum="240"
                                        TickFrequency="10"
                                        SnapsTo="Ticks"
                                        TickPlacement="BottomRight"
                                        IsEnabled="False"
                                        Margin="0,0,0,12"/>

                                <!-- Flow Scale -->
                                <Grid>
                                    <TextBlock Text="Flow Scale" FontSize="13" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="LosslessScalingFlowScaleValueText"
                                               Text="{Binding ElementName=LosslessScalingFlowScaleSlider, Path=Value}"
                                               FontSize="13"
                                               Foreground="#B9C0CC"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="LosslessScalingFlowScaleSlider"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Minimum="25" Maximum="100"
                                        TickFrequency="5"
                                        SnapsTo="Ticks"
                                        TickPlacement="BottomRight"
                                        IsEnabled="False"
                                        Margin="0,0,0,12"/>

                                <!-- Size Toggle (Performance/Balanced) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Performance Mode" FontSize="13" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Lighter model for less input lag"
                                                   FontSize="11"
                                                   Foreground="#B9C0CC"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LosslessScalingSizeToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- LSFG2 Settings Card -->
                        <Border x:Name="LSFG2SettingsCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="LSFG2 Settings" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>

                                <!-- LSFG2 Mode -->
                                <TextBlock Text="Mode" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <ComboBox x:Name="LosslessScalingLSFG2ModeComboBox"
                                          PlaceholderText="Select Mode"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="False"
                                          Style="{StaticResource ModernComboBoxStyle}">
                                    <x:String>X2</x:String>
                                    <x:String>X3</x:String>
                                    <x:String>X4</x:String>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Sync & Display Card (added 2026-05-01) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Sync &amp; Display" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>

                                <!-- Sync Mode -->
                                <TextBlock Text="Sync Mode" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <ComboBox x:Name="LosslessScalingSyncModeComboBox"
                                          PlaceholderText="Select Mode"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="False"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          Margin="0,0,0,12">
                                    <x:String>OFF</x:String>
                                    <x:String>DEFAULT</x:String>
                                    <x:String>VSYNC1</x:String>
                                    <x:String>VSYNC2</x:String>
                                    <x:String>VSYNC3</x:String>
                                    <x:String>VSYNC4</x:String>
                                </ComboBox>

                                <!-- Max Frame Latency -->
                                <Grid>
                                    <TextBlock Text="Max Frame Latency" FontSize="13" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="LosslessScalingMaxFrameLatencyValueText"
                                               Text="{Binding ElementName=LosslessScalingMaxFrameLatencySlider, Path=Value}"
                                               FontSize="13"
                                               Foreground="#B9C0CC"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="LosslessScalingMaxFrameLatencySlider"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Minimum="0" Maximum="4"
                                        TickFrequency="1"
                                        SnapsTo="Ticks"
                                        TickPlacement="BottomRight"
                                        IsEnabled="False"
                                        Margin="0,0,0,12"/>

                                <!-- HDR Support -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="HDR Support" FontSize="13" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Preserve HDR through scaling/FG"
                                                   FontSize="11" Foreground="#B9C0CC"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LosslessScalingHdrSupportToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False"/>
                                </Grid>

                                <!-- G-Sync Support -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="G-Sync / VRR Support" FontSize="13" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Improves pacing on VRR displays"
                                                   FontSize="11" Foreground="#B9C0CC"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LosslessScalingGsyncSupportToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Capture & Overlay Card (added 2026-05-01) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Capture &amp; Overlay" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>

                                <!-- Capture API -->
                                <TextBlock Text="Capture API" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <ComboBox x:Name="LosslessScalingCaptureApiComboBox"
                                          PlaceholderText="Select API"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="False"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          Margin="0,0,0,12">
                                    <x:String>DXGI</x:String>
                                    <x:String>WGC</x:String>
                                    <x:String>GDI</x:String>
                                </ComboBox>
                                <TextBlock Text="WGC = best compat, DXGI = lower latency, GDI = legacy"
                                           FontSize="11" Foreground="#888888" Margin="0,0,0,8"/>

                                <!-- Draw FPS overlay -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Draw FPS Overlay" FontSize="13" Foreground="#FFFFFF"/>
                                        <TextBlock Text="LS draws fps counter on top-left of scaled output"
                                                   FontSize="11" Foreground="#B9C0CC"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LosslessScalingDrawFpsToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Conflict Warning Card -->
                        <Border Style="{StaticResource CardStyle}" x:Name="LSConflictWarningBorder" Visibility="Collapsed" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Conflict Detected"
                                           Style="{StaticResource CardTitleStyle}"
                                           Foreground="#FFA500"/>
                                <TextBlock x:Name="LSConflictWarningText"
                                           Text="AMD Fluid Motion Frames has been automatically disabled because it conflicts with Lossless Scaling Frame Generation."
                                           FontSize="13"
                                           Foreground="#FFA500"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- LEGION TAB -->
                <ScrollViewer x:Name="LegionScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,8,16,16">

                        <!-- Controller Status Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Left Controller / Device Glyph / Right Controller, flanking row.
                                     All three panels share the same 132px height (the glyph box is
                                     taller than the others to fit the device name inside it). Left/
                                     Right cards are individually collapsible (hidden on devices
                                     without detachable controllers) via SetControllerBatterySectionVisibility. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Controller -->
                                    <Border x:Name="LeftControllerCard" Grid.Column="0" Height="132"
                                            Background="{StaticResource PageBackgroundBrush}"
                                            CornerRadius="14" Padding="12,10" Margin="0,0,8,0">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Left Controller" FontSize="12" Foreground="#B9C0CC" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE83F;" FontSize="14" Foreground="#B9C0CC" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="LeftControllerBatteryText"
                                                           Text="--%"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"/>
                                                <FontIcon x:Name="LeftControllerChargingIcon"
                                                          Glyph="&#xE945;"
                                                          FontSize="12"
                                                          Foreground="#4CAF50"
                                                          Margin="6,0,0,0"
                                                          Visibility="Collapsed"/>
                                            </StackPanel>
                                            <TextBlock x:Name="LeftControllerConnectionText"
                                                       Text="--"
                                                       FontSize="11"
                                                       Foreground="#888888"
                                                       Margin="0,2,0,0"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Device Glyph + name, stacked together in one taller box -->
                                    <Border Grid.Column="1" Width="176" Height="132" CornerRadius="18"
                                            Background="{StaticResource PageBackgroundBrush}"
                                            Margin="8,0,8,0">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="/Assets/Glyph_LeGo2.png"
                                                   Width="136" Stretch="Uniform"
                                                   HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="LegionDeviceNameText" Text="Legion Go Controller"
                                                       Style="{StaticResource CardTitleStyle}"
                                                       HorizontalAlignment="Center" TextAlignment="Center"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Right Controller -->
                                    <Border x:Name="RightControllerCard" Grid.Column="2" Height="132"
                                            Background="{StaticResource PageBackgroundBrush}"
                                            CornerRadius="14" Padding="12,10" Margin="8,0,0,0">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Right Controller" FontSize="12" Foreground="#B9C0CC" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE83F;" FontSize="14" Foreground="#B9C0CC" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="RightControllerBatteryText"
                                                           Text="--%"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"/>
                                                <FontIcon x:Name="RightControllerChargingIcon"
                                                          Glyph="&#xE945;"
                                                          FontSize="12"
                                                          Foreground="#4CAF50"
                                                          Margin="6,0,0,0"
                                                          Visibility="Collapsed"/>
                                            </StackPanel>
                                            <TextBlock x:Name="RightControllerConnectionText"
                                                       Text="--"
                                                       FontSize="11"
                                                       Foreground="#888888"
                                                       Margin="0,2,0,0"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Separator under the title -->
                                <Border Height="1" Background="#33FFFFFF" Margin="0,10,0,0"/>

                                <!-- Controller Information — Win11-style info table.
                                     Visibility is driven by UpdateLegionControllerInfoSectionVisibility()
                                     (shows as soon as EITHER VID:PID or device-status JSON has data,
                                     so VID:PID isn't hidden just because the device-status readback
                                     hasn't arrived yet). -->
                                <StackPanel x:Name="LegionControllerInfoSection" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="Controller Information"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#B9C0CC"
                                               Margin="0,0,0,8"/>

                                    <Border Background="{StaticResource PageBackgroundBrush}" CornerRadius="6" Padding="12,2">
                                        <StackPanel>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="VID:PID" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="LegionControllerPidVidText"
                                                           Text="--" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Firmware" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="LegionControllerFirmwareText"
                                                           Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Stick light" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="LegionControllerLightText"
                                                           Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                                <Border Grid.Column="2" x:Name="LegionControllerLightSwatch"
                                                        Width="14" Height="14" CornerRadius="3"
                                                        BorderThickness="1" BorderBrush="#444444"
                                                        Visibility="Collapsed"/>
                                            </Grid>
                                            <Border Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Vibration" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="LegionControllerVibrationText"
                                                           Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>

                                            <Grid Margin="0,8,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Touchpad" FontSize="12" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="LegionControllerTouchpadText"
                                                           Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Controller auto-sleep (idle power-off) timeout -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Controller sleep" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="13"/>
                                        <ComboBox x:Name="LegionControllerSleepComboBox" Grid.Column="1" Width="110"
                                                  Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="3"
                                                  SelectionChanged="LegionControllerSleepComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Never" Tag="0"/>
                                            <ComboBoxItem Content="5 min" Tag="5"/>
                                            <ComboBoxItem Content="10 min" Tag="10"/>
                                            <ComboBoxItem Content="15 min" Tag="15"/>
                                            <ComboBoxItem Content="20 min" Tag="20"/>
                                            <ComboBoxItem Content="30 min" Tag="30"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Controller Settings Section (Touchpad & Vibration + Lighting) -->
                        <TextBlock Text="Controller Settings" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Controller Mode Card: Legion Space style X-Input / D-Input switch. Only shown
                             once the helper reports a controller that supports it (see
                             UpdateLegionControllerModeUI). Switch off = X-Input, on = D-Input. -->
                        <Border x:Name="LegionControllerModeCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="D-Input mode" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock x:Name="LegionControllerModeStatusText"
                                                   Text="Controllers not detected"
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LegionControllerModeToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsOn="False"
                                                  IsEnabled="False"
                                                  XYFocusUp="{x:Bind LegionNavItem}"
                                                  XYFocusDown="{x:Bind TouchpadVibrationExpandToggle}"
                                                  Toggled="LegionControllerModeToggle_Toggled"/>
                                </Grid>
                                <TextBlock Text="Same switch as Legion Space. The controllers reconnect for a few seconds, and in D-Input the Xbox / Game Bar interface may stop responding to them - use the touchscreen to switch back."
                                           FontSize="11"
                                           Foreground="#888888"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Touchpad & Vibration Card (hidden on devices without HID touchpad support) -->
                        <StackPanel x:Name="TouchpadVibrationSection">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Touchpad &amp; Vibration" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="Touchpad and haptic feedback settings"
                                                       Style="{StaticResource CardCaptionStyle}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="TouchpadVibrationExpandToggle"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="TouchpadVibrationExpandToggle_Click"
                                                  XYFocusUp="{x:Bind LegionNavItem}">
                                        <FontIcon x:Name="TouchpadVibrationExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="TouchpadVibrationContent" Spacing="12" Margin="0,12,0,0" Visibility="Collapsed">
                                    <!-- Touchpad Toggle -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Touchpad Enabled" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                        <ToggleSwitch x:Name="LegionTouchpadToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsOn="True"
                                                      XYFocusUp="{x:Bind LegionNavItem}"
                                                      XYFocusDown="{x:Bind LegionVibrationComboBox}"/>
                                    </Grid>

                                    <!-- Vibration Intensity -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Vibration Intensity" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                        <ComboBox x:Name="LegionVibrationComboBox"
                                                  Grid.Column="1"
                                                  Width="120"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectedIndex="2">
                                            <x:String>Off</x:String>
                                            <x:String>Weak</x:String>
                                            <x:String>Medium</x:String>
                                            <x:String>Strong</x:String>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Vibration Mode -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Vibration Mode" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                        <ComboBox x:Name="LegionVibrationModeComboBox"
                                                  Grid.Column="1"
                                                  Width="120"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectedIndex="0">
                                            <x:String>FPS</x:String>
                                            <x:String>Racing</x:String>
                                            <x:String>AVG</x:String>
                                            <x:String>SPG</x:String>
                                            <x:String>RPG</x:String>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Touchpad Haptics Dropdown -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Touchpad Haptics" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                        <ComboBox x:Name="LegionTouchpadVibrationComboBox"
                                                  Grid.Column="1"
                                                  SelectedIndex="2"
                                                  Width="120"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <x:String>Off</x:String>
                                            <x:String>Low</x:String>
                                            <x:String>Medium</x:String>
                                            <x:String>High</x:String>
                                        </ComboBox>
                                    </Grid>

                                    <!-- GoTweaks Haptics: standalone per-button LRA clicks (works outside emulation) -->
                                    <Border Height="1" Background="#22FFFFFF" Margin="0,4,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="GoTweaks Haptics" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock Text="Tactile click on inputs, system-wide via the controller motors"
                                                       Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="GoTweaksHapticsMasterToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsOn="False"
                                                      Toggled="GoTweaksHaptics_Changed"/>
                                    </Grid>

                                    <StackPanel x:Name="GoTweaksHapticsGroupsPanel" Spacing="10" Margin="0,4,0,0" Visibility="Collapsed">
                                        <!-- Pulse length (tap duration) -->
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Pulse Length" FontSize="13" Foreground="#B9C0CC"/>
                                                <TextBlock x:Name="GoTweaksHapticsPulseValue" Text="10 ms" Style="{StaticResource CardValueStyle}"/>
                                            </Grid>
                                            <Slider x:Name="GoTweaksHapticsPulseSlider"
                                                    Style="{StaticResource ModernSliderStyle}"
                                                    Minimum="4" Maximum="40" Value="10"
                                                    StepFrequency="1"
                                                    ValueChanged="GoTweaksHaptics_Changed"/>
                                        </StackPanel>
                                        <!-- Also click on release -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Click on release too" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="13"/>
                                            <ToggleSwitch x:Name="GoTweaksHapticsReleaseToggle" Grid.Column="1" MinWidth="0"
                                                          Style="{StaticResource ModernToggleStyle}" IsOn="False" Toggled="GoTweaksHaptics_Changed"/>
                                        </Grid>
                                        <!-- ABXY -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleSwitch x:Name="GoTweaksHapticsFaceToggle" Grid.Column="0" MinWidth="0"
                                                          Style="{StaticResource ModernToggleStyle}" IsOn="True" Toggled="GoTweaksHaptics_Changed"/>
                                            <TextBlock Grid.Column="1" Text="ABXY buttons" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="13" Margin="8,0,0,0"/>
                                            <Slider x:Name="GoTweaksHapticsFaceSlider" Grid.Column="2" Width="110" Minimum="0" Maximum="100" Value="100"
                                                    StepFrequency="5" VerticalAlignment="Center" ValueChanged="GoTweaksHaptics_Changed"/>
                                        </Grid>
                                        <!-- Front -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleSwitch x:Name="GoTweaksHapticsFrontToggle" Grid.Column="0" MinWidth="0"
                                                          Style="{StaticResource ModernToggleStyle}" IsOn="True" Toggled="GoTweaksHaptics_Changed"/>
                                            <TextBlock Grid.Column="1" Text="Front buttons (d-pad, start, bumpers)" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="13" Margin="8,0,0,0"/>
                                            <Slider x:Name="GoTweaksHapticsFrontSlider" Grid.Column="2" Width="110" Minimum="0" Maximum="100" Value="100"
                                                    StepFrequency="5" VerticalAlignment="Center" ValueChanged="GoTweaksHaptics_Changed"/>
                                        </Grid>
                                        <!-- Back -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleSwitch x:Name="GoTweaksHapticsBackToggle" Grid.Column="0" MinWidth="0"
                                                          Style="{StaticResource ModernToggleStyle}" IsOn="True" Toggled="GoTweaksHaptics_Changed"/>
                                            <TextBlock Grid.Column="1" Text="Back buttons / paddles" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="13" Margin="8,0,0,0"/>
                                            <Slider x:Name="GoTweaksHapticsBackSlider" Grid.Column="2" Width="110" Minimum="0" Maximum="100" Value="100"
                                                    StepFrequency="5" VerticalAlignment="Center" ValueChanged="GoTweaksHaptics_Changed"/>
                                        </Grid>
                                        <!-- Triggers -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleSwitch x:Name="GoTweaksHapticsTriggerToggle" Grid.Column="0" MinWidth="0"
                                                          Style="{StaticResource ModernToggleStyle}" IsOn="True" Toggled="GoTweaksHaptics_Changed"/>
                                            <TextBlock Grid.Column="1" Text="Triggers (LT / RT)" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="13" Margin="8,0,0,0"/>
                                            <Slider x:Name="GoTweaksHapticsTriggerSlider" Grid.Column="2" Width="110" Minimum="0" Maximum="100" Value="100"
                                                    StepFrequency="5" VerticalAlignment="Center" ValueChanged="GoTweaksHaptics_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Lighting Section (hidden on devices without HID RGB lighting support) -->
                        <!-- No dedicated header - grouped under "Controller Settings" above, with Touchpad & Vibration -->
                        <StackPanel x:Name="LightingSection">
                        <!-- Lighting Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Lighting" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Controller RGB and power button lighting"
                                                   Style="{StaticResource CardCaptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="LightingExpandToggle"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="LightingExpandToggle_Click">
                                        <FontIcon x:Name="LightingExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="LightingContent" Spacing="12" Margin="0,12,0,0" Visibility="Collapsed">
                                    <!-- Light Mode -->
                                    <StackPanel>
                                        <TextBlock Text="Light Mode" FontSize="14" Foreground="#B9C0CC" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="LegionLightModeComboBox"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  HorizontalAlignment="Stretch"
                                                  SelectedIndex="1"
                                                  SelectionChanged="LegionLightModeComboBox_SelectionChanged">
                                            <x:String>Off</x:String>
                                            <x:String>Solid</x:String>
                                            <x:String>Pulse</x:String>
                                            <x:String>Dynamic</x:String>
                                            <x:String>Spiral</x:String>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Light Color (Solid, Pulse only) -->
                                    <StackPanel x:Name="LegionColorCard">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Light Color" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border x:Name="LegionColorPreview"
                                                        Width="24" Height="24"
                                                        CornerRadius="4"
                                                        Background="White"
                                                        BorderBrush="#50555C"
                                                        BorderThickness="1"
                                                        Margin="0,0,8,0"/>
                                                <Button x:Name="LegionColorExpandButton"
                                                        Content="&#xE70D;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="12"
                                                        Padding="8,4"
                                                        Background="Transparent"
                                                        Click="LegionColorExpandButton_Click"
                                                        UseSystemFocusVisuals="True"
                                                        FocusVisualPrimaryBrush="White"/>
                                            </StackPanel>
                                        </Grid>
                                        <muxc:ColorPicker x:Name="LegionColorPicker"
                                                     Visibility="Collapsed"
                                                     Margin="0,12,0,0"
                                                     Color="White"
                                                     ColorSpectrumShape="Box"
                                                     IsMoreButtonVisible="False"
                                                     IsColorSliderVisible="False"
                                                     IsColorChannelTextInputVisible="False"
                                                     IsHexInputVisible="False"
                                                     IsAlphaEnabled="False"
                                                     IsAlphaSliderVisible="False"
                                                     IsAlphaTextInputVisible="False"
                                                     ColorChanged="LegionColorPicker_ColorChanged"/>
                                    </StackPanel>

                                    <!-- Brightness (all modes except Off) -->
                                    <StackPanel x:Name="LegionBrightnessCard">
                                        <Grid>
                                            <TextBlock Text="Brightness" FontSize="14" Foreground="#B9C0CC"/>
                                            <TextBlock x:Name="LegionBrightnessValue"
                                                       Text="100%"
                                                       Style="{StaticResource CardValueStyle}"/>
                                        </Grid>
                                        <Slider x:Name="LegionBrightnessSlider"
                                                Style="{StaticResource ModernSliderStyle}"
                                                Minimum="0" Maximum="100"
                                                Value="100"
                                                ValueChanged="LegionBrightnessSlider_ValueChanged"/>
                                    </StackPanel>

                                    <!-- Speed (Pulse, Dynamic, Spiral only) -->
                                    <StackPanel x:Name="LegionSpeedCard" Visibility="Collapsed">
                                        <Grid>
                                            <TextBlock Text="Speed" FontSize="14" Foreground="#B9C0CC"/>
                                            <TextBlock x:Name="LegionSpeedValue"
                                                       Text="50%"
                                                       Style="{StaticResource CardValueStyle}"/>
                                        </Grid>
                                        <Slider x:Name="LegionSpeedSlider"
                                                Style="{StaticResource ModernSliderStyle}"
                                                Minimum="0" Maximum="100"
                                                Value="50"
                                                ValueChanged="LegionSpeedSlider_ValueChanged"/>
                                    </StackPanel>

                                    <!-- Power Light Toggle -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Power Light" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                        <ToggleSwitch x:Name="LegionPowerLightToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsOn="True"/>
                                    </Grid>

                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                        <!-- End Lighting Section -->

                        <!-- Controller Remapping Section (hidden on devices without HID controller remap support) -->
                        <StackPanel x:Name="ControllerRemappingSection">
                        <!-- Controller Remapping Section Header -->
                        <TextBlock Text="Controller Remapping" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Per-Game Controller Profile Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Per-Game Controller Profile" Style="{StaticResource CardTitleStyle}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Image x:Name="LegionControllerProfileGameIcon"
                                                   Width="16" Height="16"
                                                   Margin="0,0,6,0"
                                                   Stretch="UniformToFill"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                            <TextBlock x:Name="LegionControllerProfileGameText"
                                                       Text="No game detected"
                                                       Style="{StaticResource CardCaptionStyle}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LegionControllerProfileToggle"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsOn="False"
                                                  IsEnabled="False"
                                                  Toggled="LegionControllerProfileToggle_Toggled"/>
                                </Grid>
                                <TextBlock Text="When on, the categories checked below are remembered separately for the detected game and re-applied automatically whenever you play it. Unchecked categories always stay global (the same for every game)."
                                           Style="{StaticResource CardCaptionStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>

                                <Border Height="1" Background="#33FFFFFF" Margin="0,14,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="SAVE PER-GAME"
                                               FontSize="11" FontWeight="SemiBold" Foreground="#B9C0CC"
                                               VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="ProfileSaveCategoriesExpandToggle"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="ProfileSaveCategoriesExpandToggle_Click">
                                        <FontIcon x:Name="ProfileSaveCategoriesExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="ProfileSaveCategoriesContent" Margin="0,8,0,0" Visibility="Collapsed">
                                    <CheckBox x:Name="ProfileSaveLightingCheckBox"
                                              Content="Lighting"
                                              IsChecked="False"
                                              Foreground="#FFFFFF"
                                              Margin="0,4,0,0"
                                              Style="{StaticResource FocusableCheckBoxStyle}"
                                              Checked="ProfileSettingsCheckBox_Changed"
                                              Unchecked="ProfileSettingsCheckBox_Changed"/>
                                    <CheckBox x:Name="ProfileSaveVibrationCheckBox"
                                              Content="Vibration"
                                              IsChecked="False"
                                              Foreground="#FFFFFF"
                                              Margin="0,4,0,0"
                                              Style="{StaticResource FocusableCheckBoxStyle}"
                                              Checked="ProfileSettingsCheckBox_Changed"
                                              Unchecked="ProfileSettingsCheckBox_Changed"/>
                                    <CheckBox x:Name="ProfileSaveButtonMappingsCheckBox"
                                              Content="Button Mappings"
                                              IsChecked="False"
                                              Foreground="#FFFFFF"
                                              Margin="0,4,0,0"
                                              Style="{StaticResource FocusableCheckBoxStyle}"
                                              Checked="ProfileSettingsCheckBox_Changed"
                                              Unchecked="ProfileSettingsCheckBox_Changed"/>
                                    <CheckBox x:Name="ProfileSaveGyroSettingsCheckBox"
                                              Content="Gyro Settings"
                                              IsChecked="False"
                                              Foreground="#FFFFFF"
                                              Margin="0,4,0,0"
                                              Style="{StaticResource FocusableCheckBoxStyle}"
                                              Checked="ProfileSettingsCheckBox_Changed"
                                              Unchecked="ProfileSettingsCheckBox_Changed"/>
                                    <CheckBox x:Name="ProfileSaveNintendoLayoutCheckBox"
                                              Content="Nintendo Layout"
                                              IsChecked="False"
                                              Foreground="#FFFFFF"
                                              Margin="0,4,0,0"
                                              Style="{StaticResource FocusableCheckBoxStyle}"
                                              Checked="ProfileSettingsCheckBox_Changed"
                                              Unchecked="ProfileSettingsCheckBox_Changed"/>
                                </StackPanel>

                                <Border Height="1" Background="#33FFFFFF" Margin="0,16,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Saved Profiles"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#B9C0CC"
                                               VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="SavedProfilesExpandToggle"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="SavedProfilesExpandToggle_Click">
                                        <FontIcon x:Name="SavedProfilesExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="SavedProfilesContent" Spacing="8" Margin="0,8,0,0" Visibility="Collapsed">
                                    <!-- No profiles message -->
                                    <TextBlock x:Name="NoSavedProfilesText"
                                               Text="No saved game profiles"
                                               Foreground="#888888"
                                               FontSize="13"
                                               FontStyle="Italic"
                                               Visibility="Visible"/>

                                    <!-- Saved profiles list -->
                                    <ItemsControl x:Name="SavedProfilesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#2A2A2A" CornerRadius="6" Padding="12,8" Margin="0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Game Icon -->
                                                        <Image Grid.Column="0"
                                                               Source="{Binding IconSource}"
                                                               Width="28" Height="28"
                                                               Margin="0,0,10,0"
                                                               Stretch="UniformToFill"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IconVisibility}"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding GameName}"
                                                                       Foreground="White"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding SettingsSummary}"
                                                                       Foreground="#888888"
                                                                       FontSize="11"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2"
                                                                Content="&#xE711;"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                FontSize="12"
                                                                Background="Transparent"
                                                                Foreground="#FF6666"
                                                                BorderThickness="0"
                                                                Padding="8,4"
                                                                VerticalAlignment="Center"
                                                                Tag="{Binding ProfileKey}"
                                                                Visibility="{Binding CanDelete}"
                                                                Click="DeleteSavedProfile_Click"
                                                                ToolTipService.ToolTip="Delete profile"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Button Remapping Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Button Remapping" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Map buttons to gamepad, keyboard, or mouse"
                                                   Style="{StaticResource CardCaptionStyle}"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="ButtonRemappingExpandToggle"
                                                  Grid.Column="1"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="ButtonRemappingExpandToggle_Click">
                                        <FontIcon x:Name="ButtonRemappingExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>
                                <StackPanel x:Name="ButtonRemappingContent" Margin="0,12,0,0" Visibility="Collapsed">
                                    <!-- Back Buttons Section -->
                                    <TextBlock Text="Back Buttons" FontSize="12" Foreground="#888888" Margin="0,0,0,8"/>

                                    <!-- Y1 Button -->
                                <StackPanel Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Y1" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                        <ComboBox x:Name="LegionButtonY1TypeComboBox" Grid.Column="1" Margin="0,0,8,0"
                                                  Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                                            <x:String>Gamepad</x:String>
                                            <x:String>Keyboard</x:String>
                                            <x:String>Mouse</x:String>
                                        </ComboBox>
                                        <ComboBox x:Name="LegionButtonY1ComboBox" Grid.Column="2"
                                                  Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                                            <x:String>Disabled</x:String>
                                            <x:String>LS Click</x:String><x:String>LS Up</x:String><x:String>LS Down</x:String><x:String>LS Left</x:String><x:String>LS Right</x:String>
                                            <x:String>RS Click</x:String><x:String>RS Up</x:String><x:String>RS Down</x:String><x:String>RS Left</x:String><x:String>RS Right</x:String>
                                            <x:String>D-Pad Up</x:String><x:String>D-Pad Down</x:String><x:String>D-Pad Left</x:String><x:String>D-Pad Right</x:String>
                                            <x:String>A</x:String><x:String>B</x:String><x:String>X</x:String><x:String>Y</x:String>
                                            <x:String>LB</x:String><x:String>LT</x:String><x:String>RB</x:String><x:String>RT</x:String>
                                            <x:String>View</x:String><x:String>Menu</x:String>
                                        </ComboBox>
                                        <ComboBox x:Name="LegionButtonY1MouseComboBox" Grid.Column="2" Visibility="Collapsed"
                                                  Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                                            <x:String>Left Click</x:String><x:String>Right Click</x:String><x:String>Middle Click</x:String>
                                            <x:String>Scroll Up</x:String><x:String>Scroll Down</x:String><x:String>Scroll Left</x:String><x:String>Scroll Right</x:String>
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel x:Name="LegionButtonY1KeyboardPanel" Visibility="Collapsed" Margin="40,8,0,0" Orientation="Horizontal">
                                        <StackPanel x:Name="LegionButtonY1KeyTags" Orientation="Horizontal"/>
                                        <ComboBox x:Name="LegionButtonY1KeyComboBox" Width="100" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0">
                                            <x:String>+ Key</x:String>
                                            <x:String>A</x:String><x:String>B</x:String><x:String>C</x:String><x:String>D</x:String><x:String>E</x:String><x:String>F</x:String><x:String>G</x:String><x:String>H</x:String><x:String>I</x:String><x:String>J</x:String><x:String>K</x:String><x:String>L</x:String><x:String>M</x:String><x:String>N</x:String><x:String>O</x:String><x:String>P</x:String><x:String>Q</x:String><x:String>R</x:String><x:String>S</x:String><x:String>T</x:String><x:String>U</x:String><x:String>V</x:String><x:String>W</x:String><x:String>X</x:String><x:String>Y</x:String><x:String>Z</x:String>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- netstandard2.0 is used by the widget (UWP); the Windows 10 .NET 10 build by the helper
       (1.9.9). Same code: ValueSet and the other WinRT types come from Windows.winmd in the
       first and from the C#/WinRT projection in the second. -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0-windows10.0.26100.0</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' != 'netstandard2.0'">10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <Reference Include="Windows">
      <HintPath>C:\Program Files (x86)\Windows Kits\10\UnionMetadata\10.0.26100.0\Windows.winmd</HintPath>
    </Reference>
  </ItemGroup>

</Project>
